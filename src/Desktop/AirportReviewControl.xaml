<UserControl x:Class="FrontierAirportBuilder.Desktop.AirportReviewControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Expander x:Name="ReviewPanel" Header="Airport details / Report a simulator problem" Margin="0,12" Visibility="{Binding HasAirport,Converter={StaticResource BoolVisibility}}">
    <StackPanel Margin="0,8">
      <TextBlock Text="{Binding Airport}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Knowledge}" Foreground="#A8CFC1" TextWrapping="Wrap" Margin="0,8" />
      <TextBlock Text="{Binding Cautions}" TextWrapping="Wrap" FontSize="11" />
      <TextBlock Text="Aircraft observed (context only)" Margin="0,8,0,0" />
      <ComboBox ItemsSource="{Binding AircraftTypes}" SelectedItem="{Binding SelectedAircraft}" DisplayMemberPath="Name" />
      <TextBox Text="{Binding AircraftDescription,UpdateSourceTrigger=PropertyChanged}" MaxLength="160" />
      <TextBlock Text="MSFS version / scenery (optional)" />
      <TextBox Text="{Binding SimulatorVersion,UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
      <TextBlock Text="Your note (required for a problem)" />
      <TextBox x:Name="VisitNote" Text="{Binding Note,UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55" MaxHeight="100" VerticalScrollBarVisibility="Auto" />
      <ComboBox ItemsSource="{Binding IssueOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedIssue}" />
      <WrapPanel Margin="0,8">
        <Button x:Name="MarkVerified" Content="Mark as Verified" Command="{Binding VerifyCommand}" />
        <Button x:Name="ReportProblem" Content="Report a Problem" Command="{Binding ProblemCommand}" />
      </WrapPanel>
      <TextBlock x:Name="SavedStatus" Text="{Binding Status,NotifyOnTargetUpdated=True}" TargetUpdated="ShowSavedStatus" Foreground="#A8CFC1" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Error}" Foreground="#F0B47B" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Policy}" FontSize="10" TextWrapping="Wrap" Margin="0,8" />
    </StackPanel>
  </Expander>
</UserControl>
