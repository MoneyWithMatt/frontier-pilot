<Window x:Class="FrontierAirportBuilder.Desktop.DependencySetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Frontier Pilot · Dependency setup" Width="800" Height="780" MinWidth="650" MinHeight="500" Background="#111A22" Foreground="#E5EDF2" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
<TextBlock Text="Set up Frontier Pilot" FontSize="26" FontWeight="SemiBold"/>
<TextBlock Text="Airport building and live flight connection need two Microsoft SDK components. Follow the steps below in order. Microsoft Flight Simulator 2024 must already be installed." TextWrapping="Wrap" Margin="0,10"/>
<Border Background="#203743" CornerRadius="6" Padding="14" Margin="0,4,0,16"><TextBlock x:Name="NextStep" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="16"/></Border>
<TextBlock x:Name="SdkStatus" TextWrapping="Wrap" Foreground="#9FB4C1" Margin="0,0,0,12"/>
<Border BorderBrush="#304550" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12"><StackPanel>
<TextBlock Text="1. Install SDK Core" FontSize="18" FontWeight="SemiBold"/>
<TextBlock x:Name="CoreStatus" Margin="0,6" TextWrapping="Wrap"/>
<TextBlock Text="Download Core (264 MB), then click Install Core. Follow Microsoft's setup wizard and keep its suggested SDK folder." TextWrapping="Wrap"/>
<WrapPanel Margin="0,8,0,0"><Button x:Name="CoreButton" Content="Download Core" Click="DownloadCore"/><Button x:Name="CoreInstallButton" Content="Install Core…" Click="InstallCore" IsEnabled="False"/></WrapPanel>
</StackPanel></Border>
<Border BorderBrush="#304550" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12"><StackPanel>
<TextBlock Text="2. Install SDK Samples" FontSize="18" FontWeight="SemiBold"/>
<TextBlock x:Name="SamplesStatus" Margin="0,6" TextWrapping="Wrap"/>
<TextBlock Text="After Core is installed, download Samples (3.2 GB), then click Install Samples. Finish Microsoft's wizard. Frontier supplies the Core folder so both components install together." TextWrapping="Wrap"/>
<WrapPanel Margin="0,8,0,0"><Button x:Name="SamplesButton" Content="Download Samples" Click="DownloadSamples"/><Button x:Name="SamplesInstallButton" Content="Install Samples…" Click="InstallSamples" IsEnabled="False"/></WrapPanel>
</StackPanel></Border>
<Border BorderBrush="#304550" BorderThickness="1" CornerRadius="6" Padding="14"><StackPanel>
<TextBlock Text="3. Check and finish" FontSize="18" FontWeight="SemiBold"/>
<TextBlock Text="Check installation after each wizard closes. When both components are verified, click Finish setup to save the SDK folder." TextWrapping="Wrap" Margin="0,6"/>
<WrapPanel><Button x:Name="RecheckButton" Content="Check installation" Click="Recheck"/><Button x:Name="UseButton" Content="Finish setup" Click="UseSdk" IsEnabled="False"/></WrapPanel>
<TextBlock x:Name="DetectionFeedback" TextWrapping="Wrap" Foreground="#9FB4C1" Margin="0,8,0,0"/>
</StackPanel></Border>
<ProgressBar x:Name="Progress" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,14,0,8"/>
<TextBlock x:Name="Activity" TextWrapping="Wrap" Margin="0,8"/>
<Button x:Name="CancelButton" Content="Cancel download" Click="Cancel" IsEnabled="False" HorizontalAlignment="Left" Visibility="Collapsed"/>
<Expander Header="SDK folder and connection details" Margin="0,16,0,0"><StackPanel Margin="0,10">
<TextBlock Text="Installed SDK folder"/>
<TextBox x:Name="SdkFolder" Margin="0,6"/>
<Button x:Name="BrowseButton" Content="Choose a different folder…" Click="Browse" HorizontalAlignment="Left"/>
<TextBlock Text="Community folder" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,6"/>
<TextBlock x:Name="CommunityStatus" TextWrapping="Wrap"/>
<TextBlock x:Name="CommunityPath" TextWrapping="Wrap" Foreground="#9FB4C1" Margin="0,6"/>
<TextBlock Text="Setup uses SDK 1.2.4. Live survey also checks simulator compatibility when you connect to a loaded flight. Checking setup does not change scenery. The app already includes .NET." TextWrapping="Wrap" Foreground="#9FB4C1" Margin="0,12,0,0"/>
</StackPanel></Expander>
</StackPanel></ScrollViewer></Window>
