<UserControl x:Class="FrontierAirportBuilder.Desktop.AircraftFleetPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FrontierAirportBuilder.Desktop">
<Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,16,0">
<TextBlock Text="Physical fleet" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Select the individual aircraft you intend to operate." TextWrapping="Wrap" Margin="0,4,0,10"/>
<TextBlock Text="{Binding AllocationStatus}" TextWrapping="Wrap" Margin="0,4,0,10"/>
<ListBox ItemsSource="{Binding AircraftRows}" SelectedValuePath="Id" SelectedValue="{Binding SelectedAirframeId}" Height="240" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,7"><TextBlock Text="{Binding Type}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Registration}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="{Binding Location}" FontSize="11" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<TextBlock Text="{Binding SelectedInstructions}" TextWrapping="Wrap" Margin="0,8"/>
<TextBlock Text="{Binding MissionEligibility}" TextWrapping="Wrap" Margin="0,8"/>
<Expander Header="Legacy / personal registration" Visibility="{Binding CanEnrolPersonal,Converter={StaticResource BoolVisibility}}"><StackPanel>
<TextBlock Text="Registration" Margin="0,12,0,2"/><TextBox Text="{Binding Registration,UpdateSourceTrigger=PropertyChanged}"/>
<Button Content="Enrol loaded aircraft · unknown history" Command="{Binding EnrolCommand}" Margin="0,8,0,0"/>
<Button Content="Change selected registration" Command="{Binding RenameCommand}"/>
</StackPanel></Expander>
<Expander Header="Identity / livery confirmation"><StackPanel><TextBlock Text="Optional for an explicit livery/object change; not required to create your company allocation." TextWrapping="Wrap"/>
<TextBlock Text="Installed package / version (your declaration)" TextWrapping="Wrap"/><TextBox Text="{Binding PackageVersion,UpdateSourceTrigger=PropertyChanged}"/>
<Button Content="Bind loaded livery to selected airframe" Command="{Binding BindCommand}"/>
<TextBlock Text="Binding explicitly associates this simulator title/model with the selected physical aircraft. It does not verify compatibility or import vendor health." TextWrapping="Wrap" FontSize="11" Margin="0,8"/>
</StackPanel></Expander>
<Expander Header="Preserved legacy company records"><StackPanel><TextBlock Text="Ambiguous records are never replaced automatically. Choose an existing record and confirm its company type/assignment to reuse its identity and history." TextWrapping="Wrap"/>
<ComboBox ItemsSource="{Binding LegacyCandidates}" SelectedItem="{Binding SelectedLegacyCandidate}"/>
<ComboBox ItemsSource="{Binding EmployerTypes}" SelectedItem="{Binding SelectedLegacyType}"/>
<Button Content="Confirm existing company assignment…" Click="ConfirmLegacyAssignment"/>
</StackPanel></Expander>
<TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#F1B66A" Margin="0,8"/>
</StackPanel></ScrollViewer>
<TabControl Grid.Column="1">
<TabItem Header="Overview"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14"><TextBlock Text="{Binding ConnectionStatus}" Foreground="#A8CFC1" Margin="0,0,0,6"/><TextBlock Text="{Binding SaveStatus}" Margin="0,0,0,10"/><TextBlock Text="{Binding Overview}" FontSize="16" TextWrapping="Wrap"/><Button Content="Establish explicit healthy baseline…" Click="EstablishBaseline" IsEnabled="{Binding CanEstablishBaseline}" HorizontalAlignment="Left" Margin="0,10"/><TextBlock Text="{Binding Observations}" TextWrapping="Wrap" Margin="0,12"/><Button Content="Return to aircraft · show saved placement" Command="{Binding ReturnCommand}" HorizontalAlignment="Left"/><Button Content="Developer recovery: acknowledge external relocation…" Click="AcknowledgeRelocation" IsEnabled="{Binding Selected.LocationReconciliationRequired}" HorizontalAlignment="Left"/><TextBlock Text="{Binding ReturnInstructions}" TextWrapping="Wrap" Margin="0,10"/><local:OperationsWorldMap x:Name="FleetMap" Height="290" Visibility="{Binding HasLocations,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="Last-known aircraft locations · © OpenStreetMap contributors" FontSize="11"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Condition"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Components}" TextWrapping="Wrap" Margin="14"/></ScrollViewer></TabItem>
<TabItem Header="Maintenance"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14"><TextBlock Text="Maintenance requirements" FontSize="19"/><TextBlock Text="Component" Margin="0,8,0,3"/><ComboBox ItemsSource="{Binding Selected.Components}" SelectedItem="{Binding SelectedComponent}" DisplayMemberPath="Key"/><TextBlock Text="Work type" Margin="0,8,0,3"/><ComboBox ItemsSource="{Binding MaintenanceActions}" SelectedItem="{Binding SelectedAction}"/><TextBlock Text="Qualified service facility (none enabled yet)" Margin="0,8,0,3"/><ComboBox ItemsSource="{Binding Facilities}" SelectedItem="{Binding SelectedFacility}" DisplayMemberPath="Name"/><TextBlock Text="{Binding QuoteDescription}" TextWrapping="Wrap" Margin="0,8"/><Button Content="Confirm work order…" Click="BookMaintenance" IsEnabled="{Binding CanBookMaintenance}" HorizontalAlignment="Left"/><TextBlock Text="{Binding MaintenanceSummary}" TextWrapping="Wrap" Margin="0,10"/><TextBlock Text="Work requires qualified stationary dry-ground location, facility capability and engine shutdown. Unknown condition requires inspection; it is not a confirmed defect. The prototype quotes do not enable a facility or certify a repair." TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="History"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding History}" TextWrapping="Wrap" Margin="14"/></ScrollViewer></TabItem>
</TabControl></Grid></UserControl>
