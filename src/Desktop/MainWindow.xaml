<Window x:Class="FrontierAirportBuilder.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Frontier Airport Builder · Prototype 0.1" Width="1100" Height="900" MinWidth="850" MinHeight="650" Background="#F0F3EF" Foreground="#203C35" FontFamily="Segoe UI" FontSize="14">
<DockPanel>
<Border DockPanel.Dock="Top" Background="#203C35" Padding="26,18"><StackPanel><TextBlock Text="FRONTIER AIRPORT BUILDER" Foreground="White" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Prototype 0.1 · From a place on the ground to a runway in your world" Foreground="#C4D7CA" Margin="0,6,0,0"/></StackPanel></Border>
<Border DockPanel.Dock="Bottom" Background="White" Padding="24,12"><StackPanel>
<TextBlock Text="{Binding Stage}" FontWeight="Bold"/><TextBlock Text="{Binding Status}" Margin="0,4"/>
<ProgressBar Height="4" IsIndeterminate="{Binding IsBusy}" Margin="0,5"/>
<TextBlock Text="{Binding Error}" Foreground="#A52222"/>
<WrapPanel><Button Content="Generate and compile" Command="{Binding BuildCommand}"/><Button Content="Install airport" Command="{Binding InstallCommand}"/><Button Content="Cancel" Command="{Binding CancelCommand}"/><Button Content="Project" Command="{Binding OpenProjectCommand}"/><Button Content="Package" Command="{Binding OpenPackageCommand}"/><Button Content="Build log" Command="{Binding OpenLogCommand}"/><Button Content="Evidence" Command="{Binding OpenEvidenceCommand}"/></WrapPanel>
</StackPanel></Border>
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,20">
<Border Style="{StaticResource Card}"><StackPanel>
<TextBlock Style="{StaticResource Title}" Text="1. Connect to your flight"/>
<TextBlock Text="Load a flight in MSFS 2024 with your aircraft parked. We will verify the supported simulator build and SDK before surveying."/>
<Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><Label Content="_SDK folder" Target="{Binding ElementName=Sdk}"/><TextBox x:Name="Sdk" Text="{Binding SdkRoot, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"/></StackPanel><Button Grid.Column="1" Content="Check and connect" VerticalAlignment="Bottom" Margin="0,0,0,10" Command="{Binding CheckCommand}"/></Grid>
</StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel>
<TextBlock Style="{StaticResource Title}" Text="2. Stand at your runway centre"/>
<TextBlock Text="Exit the aircraft. Stand upright at the intended runway centre, face along the runway and remain still for at least five seconds. Leave the aircraft parked. Capture uses the walking avatar only."/>
<WrapPanel><Button Content="Capture survey" Command="{Binding CaptureCommand}"/><TextBlock Text="Empirical elevation · validated simulator build only" VerticalAlignment="Center" FontSize="12"/></WrapPanel>
<Border Background="#EDF4EF" Padding="12"><TextBlock Text="{Binding SurveyText}" FontFamily="Consolas" FontSize="15"/></Border>
<TextBlock Text="After capture, close MSFS before compiling or installing. Your survey stays in this window." Margin="0,10,0,0" FontWeight="SemiBold"/>
</StackPanel></Border>
<Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
<StackPanel IsEnabled="{Binding CanEdit}">
<TextBlock Style="{StaticResource Title}" Text="3. Define your airstrip"/>
<Label Content="Airport _name" Target="{Binding ElementName=NameField}"/><TextBox x:Name="NameField" Text="{Binding AirportName, UpdateSourceTrigger=PropertyChanged}"/>
<Label Content="_Identifier · 3–8 letters or digits, starting with a letter" Target="{Binding ElementName=IdField}"/><TextBox x:Name="IdField" Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><Label Content="_Length (metres)" Target="{Binding ElementName=LengthField}"/><TextBox x:Name="LengthField" Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="1"><Label Content="_Width (metres)" Target="{Binding ElementName=WidthField}"/><TextBox x:Name="WidthField" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
<Label Content="_Surface" Target="{Binding ElementName=SurfaceField}"/><ComboBox x:Name="SurfaceField" ItemsSource="{Binding Surfaces}" SelectedItem="{Binding Surface}" Padding="8" Margin="0,0,12,12"/>
<CheckBox IsChecked="{Binding SiteConfirmed}" Margin="0,0,12,10"><TextBlock Text="I checked the world map: this identifier is unused and the site is flat, empty and away from existing airports."/></CheckBox>
<TextBlock Text="{Binding ValidationMessage}" Foreground="#695728" FontSize="12"/>
</StackPanel>
<StackPanel Grid.Column="1" Margin="18,0,0,0">
<TextBlock Text="Runway preview" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Designators}" FontSize="30" Margin="0,8"/>
<Grid Height="250" Background="#E3EBDF" ClipToBounds="True"><TextBlock Text="N ↑" HorizontalAlignment="Center" Margin="0,8" VerticalAlignment="Top"/><Rectangle Width="{Binding PreviewWidth}" Height="180" Fill="#9C8761" Stroke="#6D6048" RenderTransformOrigin=".5,.5"><Rectangle.RenderTransform><RotateTransform Angle="{Binding PreviewHeading}"/></Rectangle.RenderTransform></Rectangle><Ellipse Width="8" Height="8" Fill="#203C35"/></Grid>
<TextBlock Text="North up · centre dot is your survey. Designators use magnetic heading; orientation uses true heading. Width is exaggerated for narrow strips." FontSize="12" Margin="0,10"/>
</StackPanel></Grid></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Title}" Text="4. Build, install and fly"/><TextBlock Text="Generate and compile creates an isolated project. Install verifies the package and backs up any previous installation owned by this app. FPT1 and FPSC are protected. The full runway footprint still needs a visual terrain check."/><TextBlock Text="{Binding SuccessInstructions}" FontWeight="SemiBold" Margin="0,10"/><Expander Header="Activity details"><TextBox Text="{Binding ActivityLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto"/></Expander></StackPanel></Border>
</StackPanel></ScrollViewer>
</DockPanel></Window>
