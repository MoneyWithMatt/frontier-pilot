<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FrontierAirportBuilder.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FrontierAirportBuilder.Desktop" Title="Frontier Pilot · Prototype 0.1" Width="1280" Height="860" MinWidth="1040" MinHeight="650" Background="#111A22" Foreground="#E5EDF2" FontFamily="Segoe UI" FontSize="14">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Border Background="#1A2732" Padding="12,4"><DockPanel><Button Content="Dependency setup…" Click="OpenDependencySetup" HorizontalAlignment="Right" DockPanel.Dock="Right"/><TextBlock Text="Frontier Pilot setup" VerticalAlignment="Center" Foreground="#9FB4C1"/></DockPanel></Border><DockPanel x:Name="GameplayShell" Grid.Row="1">
<Border DockPanel.Dock="Top" Background="#203C35" Padding="22,12"><DockPanel><TextBlock x:Name="WorldClock" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#C4D7CA"/><StackPanel><TextBlock Text="FRONTIER PILOT" Foreground="White" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="FLY · BUILD · GROW" Foreground="#C4D7CA" Margin="0,3,0,0" /></StackPanel></DockPanel></Border>
<Border x:Name="BuilderFooter" DockPanel.Dock="Bottom" Background="#1A2732" Padding="20,8" Visibility="Collapsed"><StackPanel>
<TextBlock Text="{Binding Status}" Margin="0,4" />
<ProgressBar Height="4" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}" Margin="0,5" />
<TextBlock Text="{Binding Error}" Foreground="#FF9999" /><TextBlock Text="{Binding RecoveryAction}" FontWeight="SemiBold" />
<WrapPanel><Button Content="Validate" Command="{Binding ValidateCommand}" /><Button Content="Generate and compile" Command="{Binding BuildCommand}" /><Button Content="Install site" Command="{Binding InstallCommand}" /><Button Content="Cancel" Command="{Binding CancelCommand}" /></WrapPanel><Expander Header="Build files and diagnostics"><WrapPanel><Button Content="Project" Command="{Binding OpenProjectCommand}" /><Button Content="Package" Command="{Binding OpenPackageCommand}" /><Button Content="Build log" Command="{Binding OpenLogCommand}" /><Button Content="Evidence" Command="{Binding OpenEvidenceCommand}" /></WrapPanel></Expander>
</StackPanel></Border>
<TabControl Style="{StaticResource Navigation}" x:Name="MainTabs" SelectionChanged="MainTabsChanged" SelectedIndex="5"><TabItem x:Name="BuilderTab" Header="" Width="0" MinWidth="0" Padding="0" Focusable="False"><ScrollViewer x:Name="BuilderScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
<Border Background="#1A3037" BorderBrush="#86A99A" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14"><StackPanel>
<WrapPanel><Button Content="Back to My Sites" Click="BackToMySites" /><Button Content="New site" Click="NewAirport" IsEnabled="{Binding CanManageAirports}" /><Button Content="Save site" Command="{Binding SaveAirportCommand}" /></WrapPanel>
<TextBlock Text="{Binding BuilderTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,4" />
<TextBlock Text="{Binding BuilderGuidance}" TextWrapping="Wrap" />
<TextBlock Text="{Binding SaveStatus}" FontWeight="SemiBold" Margin="0,0,0,10" />
<StackPanel Visibility="{Binding IsCreatingSite,Converter={StaticResource BoolVisibility}}"><TextBlock Style="{StaticResource Title}" Text="Connect to your flight" />
<TextBlock Text="{Binding CheckInstructions}" />
<Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><Label Content="_SDK folder" Target="{Binding ElementName=Sdk}" /><TextBox x:Name="Sdk" Text="{Binding SdkRoot, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSdk}" /></StackPanel><Button Grid.Column="1" Content="Check and connect" VerticalAlignment="Bottom" Margin="0,0,0,10" Command="{Binding CheckCommand}" /></Grid></StackPanel>
</StackPanel></Border>
<Border Style="{StaticResource Card}" Visibility="{Binding IsCreatingSite,Converter={StaticResource BoolVisibility}}"><StackPanel>
<TextBlock Style="{StaticResource Title}" Text="Survey the site anchor" />
<TextBlock Text="{Binding CaptureInstructions}" />
<WrapPanel><Button Content="Capture survey" Command="{Binding CaptureCommand}" /><TextBlock Text="Empirical elevation · validated simulator build only" VerticalAlignment="Center" FontSize="12" /></WrapPanel>
<Border Background="#1A2D38" Padding="12"><TextBlock Text="{Binding SurveyText}" FontFamily="Consolas" FontSize="15" /></Border>
<TextBlock Text="{Binding AfterCaptureInstructions}" Margin="0,10,0,0" FontWeight="SemiBold" />
</StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel>
<TextBlock Style="{StaticResource Title}" Text="Site layout" />
<TextBlock Text="{Binding LayoutSummary}" FontWeight="SemiBold" Foreground="#53C99B" Margin="0,0,0,6" />
<WrapPanel><Button Content="Draw runway" Click="PlaceRunway" IsEnabled="{Binding CanLayout}" /><Button Content="Remove runway" Click="RemoveRunway" IsEnabled="{Binding CanEditRunwayLayout}" /><Button Content="Cancel runway placement" Click="CancelRunway" Visibility="{Binding IsPlacingRunway,Converter={StaticResource BoolVisibility}}" /><Button Content="Add parking stand" Command="{Binding AddParkingCommand}" ToolTip="Place a stand now. Until a runway exists, it is a saved plan rather than an MSFS spawn." /><Button Content="Add Small Base Lodge" Command="{Binding AddObjectCommand}" /><Button Content="Delete selected" Command="{Binding RemoveParkingCommand}" /><Button Content="Undo" Command="{Binding UndoLayoutCommand}" /><Button Content="Redo" Command="{Binding RedoLayoutCommand}" /><Button Content="Fit site" Click="FitLayout" /><Button Content="Draw taxiway" Click="NewTaxiway" IsEnabled="{Binding CanLayout}" /></WrapPanel>
<TextBlock Text="{Binding RunwayPlacementInstructions}" FontWeight="SemiBold" Foreground="#F1B66A" Margin="0,3,0,6" />
<WrapPanel><Button Content="Finish taxiway" Click="FinishTaxiway" Visibility="{Binding Layout.IsDrawingTaxiway,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding Layout.CanFinishTaxiway}" /><Button Content="Cancel drawing" Click="CancelTaxiway" Visibility="{Binding Layout.IsDrawingTaxiway,Converter={StaticResource BoolVisibility}}" /></WrapPanel>
<TextBlock Text="{Binding Layout.TaxiwayInstructions}" Visibility="{Binding Layout.IsDrawingTaxiway,Converter={StaticResource BoolVisibility}}" />

<WrapPanel Visibility="{Binding Layout.HasTaxiwaySelection,Converter={StaticResource BoolVisibility}}"><Label Content="Selected taxiway name" /><TextBox Width="90" Text="{Binding Layout.TaxiwayName,UpdateSourceTrigger=PropertyChanged}" /><Label Content="Width (3–60 m)" /><TextBox Width="70" Text="{Binding Layout.TaxiwayWidth,UpdateSourceTrigger=PropertyChanged}" /><Button Content="Apply taxiway properties" Click="ApplyTaxiway" /></WrapPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
<Border BorderBrush="#344753" BorderThickness="1" Background="#182A33" Margin="0,0,16,0"><local:SiteLayoutMap x:Name="LayoutCanvas" Height="360" MinWidth="300" AutomationProperties.Name="Georeferenced site layout map" /></Border>
<StackPanel Grid.Column="1">
<StackPanel Visibility="{Binding Layout.HasSelection,Converter={StaticResource BoolVisibility}}">
<TextBlock Text="{Binding Layout.SelectedNumber, StringFormat='Selected stand {0}'}" FontWeight="Bold" />
<Label Content="East offset (m)" /><TextBox Text="{Binding Layout.East,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
<Label Content="North offset (m)" /><TextBox Text="{Binding Layout.North,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
<Label Content="True heading (°)" /><TextBox Text="{Binding Layout.Heading,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
<Label Content="Radius (m)" /><TextBox Text="{Binding Layout.Radius,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
<TextBlock Text="Parking type" FontSize="12" /><ComboBox ItemsSource="{Binding Layout.Types}" SelectedItem="{Binding Layout.Type}" Margin="0,6" /><TextBlock Text="Parking name" FontSize="12" /><ComboBox ItemsSource="{Binding Layout.Names}" SelectedItem="{Binding Layout.Name}" Margin="0,6" />
<Button Content="Apply properties" Command="{Binding ApplyParkingCommand}" />
<WrapPanel><Button Content="↶ 15°" Command="{Binding RotateLeftCommand}" /><Button Content="↷ 15°" Command="{Binding RotateRightCommand}" /></WrapPanel>
</StackPanel>
<Separator Margin="0,12" />
<StackPanel Visibility="{Binding Layout.HasObjectSelection,Converter={StaticResource BoolVisibility}}">
<TextBlock Text="{Binding Layout.SelectedObjectName}" FontWeight="Bold" TextWrapping="Wrap" />
<TextBlock Text="{Binding Layout.SelectedObjectDetails}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,6" />
<Label Content="East offset (m)" /><TextBox Text="{Binding Layout.ObjectEast,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
<Label Content="North offset (m)" /><TextBox Text="{Binding Layout.ObjectNorth,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
<Label Content="True heading (°)" /><TextBox Text="{Binding Layout.ObjectHeading,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
<Button Content="Apply object properties" Command="{Binding ApplyObjectCommand}" />
<WrapPanel><Button Content="↶ 15°" Command="{Binding RotateLeftCommand}" /><Button Content="↷ 15°" Command="{Binding RotateRightCommand}" /></WrapPanel>
</StackPanel>
</StackPanel></Grid>
<TextBlock Text="{Binding Layout.Message}" Foreground="#FF9999" /><TextBlock Text="{Binding Layout.IsDirty,StringFormat='Unsaved layout changes: {0}'}" />
<Expander Header="Map help and layout files"><StackPanel><WrapPanel><Button Content="Save layout…" Click="SaveLayout" IsEnabled="{Binding CanLayout}" /><Button Content="Load layout…" Click="LoadLayout" IsEnabled="{Binding CanLayout}" /></WrapPanel><TextBlock Text="Click an object to select it. Drag buildings or stands to move them. R / Shift+R rotates. Right-drag pans; wheel zooms; Home fits the site."/><TextBlock Text="Online OpenStreetMap tiles are a geographic reference; the surveyed anchor and metre offsets remain authoritative. With no runway, the map shows the anchor, buildings and planned parking. Apply property edits before saving or validating. The lodge is a temporary stock house." FontSize="12" />
<TextBlock FontSize="11" Margin="0,4,0,0">Map data © <Hyperlink NavigateUri="https://www.openstreetmap.org/copyright" RequestNavigate="OpenMapAttribution">OpenStreetMap contributors</Hyperlink></TextBlock></StackPanel></Expander>
</StackPanel></Border><Border Style="{StaticResource Card}"><Grid>
<StackPanel IsEnabled="{Binding CanEdit}">
<TextBlock Style="{StaticResource Title}" Text="Site details" />
<Label Content="Site _name" Target="{Binding ElementName=NameField}" /><TextBox x:Name="NameField" Text="{Binding AirportName, UpdateSourceTrigger=PropertyChanged}" />
<Label Content="_Identifier · 3–8 letters or digits, starting with a letter" Target="{Binding ElementName=IdField}" /><TextBox x:Name="IdField" IsEnabled="{Binding CanEditIdentifier}" Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}" />

<TextBlock Text="{Binding AccessDescription}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,12,8" />
<StackPanel IsEnabled="{Binding HasRunway}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><Label Content="_Length (metres)" Target="{Binding ElementName=LengthField}" /><TextBox x:Name="LengthField" Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="1"><Label Content="_Width (metres)" Target="{Binding ElementName=WidthField}" /><TextBox x:Name="WidthField" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid>
<WrapPanel><StackPanel><Label Content="Heading (° true)" /><TextBox Text="{Binding RunwayHeading,UpdateSourceTrigger=LostFocus}" Width="100" /></StackPanel><StackPanel><Label Content="Centre east (m)" /><TextBox Text="{Binding RunwayEast,UpdateSourceTrigger=LostFocus}" Width="110" /></StackPanel><StackPanel><Label Content="Centre north (m)" /><TextBox Text="{Binding RunwayNorth,UpdateSourceTrigger=LostFocus}" Width="110" /></StackPanel></WrapPanel>
<CheckBox Content="Hide runway surface (MSFS still flattens terrain)" IsChecked="{Binding RunwayTransparent}" Margin="0,8" />
<Label Content="_Surface preset" Target="{Binding ElementName=SurfaceField}" /><ComboBox x:Name="SurfaceField" ItemsSource="{Binding SurfacePresets}" SelectedItem="{Binding SelectedSurfacePreset}" Padding="8" Margin="0,0,12,4" /><TextBlock Text="{Binding SurfacePresetDetail}" FontSize="11" TextWrapping="Wrap" Margin="0,0,12,12" /></StackPanel>
<CheckBox IsChecked="{Binding SiteConfirmed}" Margin="0,0,12,10"><TextBlock Text="{Binding SiteCheckText}" /></CheckBox>
<TextBlock Text="{Binding ValidationMessage}" Foreground="#E6BC76" FontSize="12" />
</StackPanel></Grid></Border>

<Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Title}" Text="Build and installation help" /><TextBlock Text="Generate and compile creates an isolated project. Install verifies the package and backs up any previous installation owned by this app. FPT1 and FPSC are protected. The full runway footprint still needs a visual terrain check." /><TextBlock Text="{Binding SuccessInstructions}" FontWeight="SemiBold" Margin="0,10" /><Expander Header="Technical log (select text to copy)"><StackPanel><WrapPanel><Button Content="Copy technical log" Click="CopyLog" /><Button Content="Save technical log…" Click="SaveLog" /></WrapPanel><TextBox Text="{Binding TechnicalLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto" /></StackPanel></Expander></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Jobs"><Grid Margin="20" DataContext="{Binding Jobs}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Cargo Jobs" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="Choose company cargo work or logistics for a founded operation. Route information describes known data and does not certify flight safety." TextWrapping="Wrap" /><Border Background="#22343E" Padding="9" Margin="0,10,0,0"><StackPanel><TextBlock Text="{Binding EmploymentStatus}" TextWrapping="Wrap" /><TextBlock Text="{Binding BoardTiming}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
<WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button Content="Refresh jobs" Command="{Binding RefreshCommand}" /><TextBlock Text="{Binding Balance}" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0" /></WrapPanel>
<TabControl Grid.Row="2" Margin="0,8,0,0">
<TabItem Header="Available jobs"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding Offers}" SelectedItem="{Binding SelectedOffer}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Employer" Binding="{Binding Employer}" Width="2*" /><DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="2*" /><DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="2*" /><DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" Width="*" /><DataGridTextColumn x:Name="OfferCompensationColumn" Visibility="Collapsed" Header="Compensation" Binding="{Binding Payment}" Width="155" /><DataGridTextColumn Header="Availability" Binding="{Binding Availability}" Width="150" /></DataGrid.Columns></DataGrid><Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0"><StackPanel><TextBlock Text="Selected offer" Style="{StaticResource Title}" /><TextBlock Text="{Binding SelectedOffer.Cargo}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedOffer.Route}" TextWrapping="Wrap" Margin="0,5"/><TextBlock Text="Company aircraft for this job" Margin="0,8,0,2"/><ComboBox ItemsSource="{Binding CompanyAircraftChoices}" SelectedItem="{Binding SelectedCompanyAircraft}" Margin="0,0,0,8"/><TextBlock Text="{Binding SelectedPurpose}" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedDestinationInformation}" TextWrapping="Wrap" Margin="0,8,0,12" /><Button Content="Accept and reserve job" Command="{Binding AcceptCommand}" HorizontalAlignment="Left" /><TextBlock Text="Accepting reserves the cargo and contract. It does not choose it for the next aircraft load." FontSize="11" Foreground="#A8BBC8" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Border></Grid></TabItem>
<TabItem Header="Reserved jobs"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions><DataGrid x:Name="ReservedJobsList" ItemsSource="{Binding ReservedJobs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow"><DataGrid.Columns><DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="2*" /><DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="2*" /><DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" Width="*" /><DataGridTextColumn x:Name="ReservedCompensationColumn" Visibility="Collapsed" Header="Compensation" Binding="{Binding Payment}" Width="3*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="State" Binding="{Binding Shipment}" Width="2*" /></DataGrid.Columns></DataGrid><StackPanel Grid.Column="1" Margin="12,0,0,0"><Border Style="{StaticResource Card}" Margin="0"><StackPanel><TextBlock Text="Prepare aircraft cargo" Style="{StaticResource Title}" /><TextBlock Text="{Binding ReservedSummary}" FontWeight="SemiBold" /><TextBlock Text="Use Cargo dispatch / manifest to load explicit consignments for different destinations, make partial deliveries and pick up more cargo. Older saved loads retain the same-route Aircraft recovery workflow." TextWrapping="Wrap" Margin="0,6,0,10" /><Button Content="Open multi-stop cargo / manifest" Click="OpenCargoDispatch" HorizontalAlignment="Left" /><Expander Header="Legacy same-route loading / recovery"><Button Content="Prepare selected jobs…" Click="PrepareReservedJobs" HorizontalAlignment="Left" /></Expander><TextBlock Text="{Binding LoadingSelectionSummary}" TextWrapping="Wrap" Foreground="#A8BBC8" Margin="0,8,0,0" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Current flight" Style="{StaticResource Title}" /><TextBlock Text="{Binding FlightStage}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding FlightReason}" TextWrapping="Wrap" /><TextBlock Text="{Binding VerifiedAirborneTime}" /><TextBlock Text="{Binding OriginDistance}" /><TextBlock Text="{Binding DestinationDistance}" /></StackPanel></Border></StackPanel></Grid></TabItem>
<TabItem Header="History"><DataGrid Margin="8" ItemsSource="{Binding CompletedJobs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="2*" /><DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="2*" /><DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" Width="*" /><DataGridTextColumn Header="Compensation" Binding="{Binding Payment}" Width="3*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="State" Binding="{Binding Shipment}" Width="2*" /></DataGrid.Columns></DataGrid></TabItem>
</TabControl>
<StackPanel Grid.Row="3"><TextBlock Text="{Binding Status}" FontWeight="SemiBold" /><TextBlock Text="{Binding Error}" Foreground="#FF9999" TextWrapping="Wrap" /><TextBlock Text="{Binding StoragePath}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" /><TextBlock Text="{Binding FlightStoragePath}" FontSize="9" TextWrapping="Wrap" /><Expander Header="Live flight evidence diagnostics" Margin="0,3,0,0"><StackPanel><TextBlock Text="Live observations" FontWeight="Bold" /><TextBlock Text="{Binding DiagnosticConnection,StringFormat='SimConnect: {0}'}" /><TextBlock Text="{Binding DiagnosticFreshness,StringFormat='Telemetry: {0}'}" /><TextBlock Text="{Binding DiagnosticLastSample,StringFormat='Last valid sample UTC: {0}'}" /><TextBlock Text="{Binding DiagnosticObservedAircraft,StringFormat='Observed aircraft: {0}'}" TextWrapping="Wrap" /><TextBlock Text="{Binding DiagnosticLiveValues}" /><TextBlock Text="{Binding DiagnosticDistances}" /><Separator Margin="0,5" /><TextBlock Text="Persisted evidence" FontWeight="Bold" /><TextBlock Text="{Binding FlightStage,StringFormat='Stage: {0}'}" /><TextBlock Text="{Binding DiagnosticRoute}" /><TextBlock Text="{Binding DiagnosticIds}" FontFamily="Consolas" /><TextBlock Text="{Binding DiagnosticRecordedAircraft,StringFormat='Recorded aircraft: {0}'}" TextWrapping="Wrap" /><TextBlock Text="{Binding DiagnosticPersistedEvidence}" TextWrapping="Wrap" /><Separator Margin="0,5" /><TextBlock Text="Derived diagnostic values" FontWeight="Bold" /><TextBlock Text="{Binding DiagnosticQualification}" /><TextBlock Text="{Binding DiagnosticUnavailableReason,StringFormat='Unavailable reason: {0}'}" TextWrapping="Wrap" /><TextBlock Text="Diagnostic events describe observations only; they never qualify a delivery or certify flight safety." FontSize="11" TextWrapping="Wrap" Margin="0,3" /><DataGrid ItemsSource="{Binding DiagnosticTimeline}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="150" Margin="0,5"><DataGrid.Columns><DataGridTextColumn Header="UTC" Binding="{Binding Utc}" Width="2*" /><DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="2*" /><DataGridTextColumn Header="Factual details" Binding="{Binding Details}" Width="4*" /></DataGrid.Columns></DataGrid><WrapPanel><Button Content="Copy diagnostic summary" Click="CopyFlightDiagnosticSummary" /><Button Content="Export support bundle…" Click="ExportFlightDiagnostic" /><Button Content="Reset incomplete observations…" Click="ResetIncompleteFlight" IsEnabled="{Binding CanResetIncompleteFlight}" /></WrapPanel></StackPanel></Expander></StackPanel>
</Grid></TabItem>
<TabItem Header="Aircraft"><Grid Margin="12,10" DataContext="{Binding AircraftLoading}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid Margin="2,0,2,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Aircraft" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{Binding Aircraft}" Foreground="#A8BBC8" FontSize="12" /></StackPanel><Button Grid.Column="1" Content="Refresh from MSFS" Command="{Binding RefreshCommand}" Padding="10,6" VerticalAlignment="Center" /></Grid>
<TabControl Grid.Row="1">
<TabItem Header="Fleet"><local:AircraftFleetPanel DataContext="{Binding DataContext.Fleet, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/></TabItem>
<TabItem Header="Payload">
<Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
<Grid Grid.Column="0" Margin="0,0,10,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Border Background="#203C35" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CARGO STATIONS" Foreground="White" FontWeight="Bold" /><TextBlock Text="Type the Frontier cargo desired in each station." Foreground="#DCE9E4" FontSize="11" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="SHIPMENT" Foreground="#A8CFC1" FontSize="10" HorizontalAlignment="Right" /><TextBlock Text="{Binding JobCargoKilograms,StringFormat='{}{0:0.##} kg'}" Foreground="White" FontSize="19" FontWeight="Bold" /></StackPanel></Grid></Border>
<Grid Grid.Row="1" Margin="5,6,5,2"><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="125" /><ColumnDefinition Width="85" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /><ColumnDefinition Width="85" /></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="STATION" FontSize="9" Foreground="#A8BBC8" /><TextBlock Grid.Column="2" Text="OTHER" FontSize="9" Foreground="#A8BBC8" /><TextBlock Grid.Column="3" Text="FRONTIER CARGO" FontSize="9" Foreground="#A8BBC8" /><TextBlock Grid.Column="4" Text="KG" FontSize="9" Foreground="#A8BBC8" /><TextBlock Grid.Column="5" Text="TOTAL" FontSize="9" Foreground="#A8BBC8" /></Grid>
<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding PayloadStations}" IsEnabled="{Binding CanEditCargo}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#344753" BorderThickness="0,0,0,1" Padding="5,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="125" /><ColumnDefinition Width="85" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /><ColumnDefinition Width="85" /></Grid.ColumnDefinitions><Border Width="23" Height="23" CornerRadius="12" Background="#22343E" VerticalAlignment="Center"><TextBlock Text="{Binding Index}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{Binding Limit,StringFormat='Limit: {0}'}" FontSize="9" Foreground="#A8BBC8" /></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding CurrentKilograms,StringFormat='{}{0:0.00} kg'}" FontSize="12" /><TextBlock Text="{Binding CurrentPounds,StringFormat='{}{0:0.0} lb'}" FontSize="9" Foreground="#A8BBC8" /></StackPanel><Grid Grid.Column="3" Grid.ColumnSpan="2" Margin="4,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="29" /></Grid.ColumnDefinitions><TextBox Text="{Binding AssignedKilogramsText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" GotKeyboardFocus="SelectAllNumericText" PreviewMouseLeftButtonDown="FocusNumericText" Margin="0" Padding="5,3" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" /><Button Grid.Column="1" Content="0" Command="{Binding ResetCommand}" Padding="3" Margin="2,0,0,0" ToolTip="Set this Frontier cargo allocation to zero" /></Grid><StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding PlannedKilograms,StringFormat='{}{0:0.00} kg'}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding PlannedPounds,StringFormat='{}{0:0.0} lb'}" FontSize="9" Foreground="#A8BBC8" HorizontalAlignment="Right" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
<Border Grid.Row="3" Background="#1A2732" Padding="8" Margin="0,7,0,0"><StackPanel><TextBlock Text="{Binding CargoReason}" Foreground="#F1B66A" FontSize="12" Margin="2,0,2,4" TextWrapping="Wrap" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Content="Set cargo to zero" Command="{Binding ClearAllocationCommand}" Padding="9,6" /><Button Grid.Column="1" Content="{Binding PrimaryCargoActionText}" Click="ApplyPrimaryAircraftLoad" IsEnabled="{Binding CanUsePrimaryCargoAction}" Background="#2E9B59" Foreground="White" FontWeight="SemiBold" Padding="10,7" HorizontalAlignment="Stretch" /></Grid></StackPanel></Border>
</Grid>
