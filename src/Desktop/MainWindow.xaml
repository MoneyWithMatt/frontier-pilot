<Window x:Class="FrontierAirportBuilder.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FrontierAirportBuilder.Desktop" Title="Frontier Pilot · Prototype 0.1" Width="1100" Height="900" MinWidth="850" MinHeight="650" Background="#F0F3EF" Foreground="#203C35" FontFamily="Segoe UI" FontSize="14">
<DockPanel>
<Border DockPanel.Dock="Top" Background="#203C35" Padding="26,18"><StackPanel><TextBlock Text="FRONTIER PILOT" Foreground="White" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Prototype 0.1 · Airport Builder and live aircraft tracking" Foreground="#C4D7CA" Margin="0,6,0,0"/></StackPanel></Border>
<Border x:Name="BuilderFooter" DockPanel.Dock="Bottom" Background="White" Padding="24,12"><StackPanel>
<TextBlock Text="{Binding Stage}" FontWeight="Bold"/><TextBlock Text="{Binding Status}" Margin="0,4"/>
<ProgressBar Height="4" IsIndeterminate="{Binding IsBusy}" Margin="0,5"/>
<TextBlock Text="{Binding Error}" Foreground="#A52222"/><TextBlock Text="{Binding RecoveryAction}" FontWeight="SemiBold"/>
<WrapPanel><Button Content="Validate" Command="{Binding ValidateCommand}"/><Button Content="Generate and compile" Command="{Binding BuildCommand}"/><Button Content="Install airport" Command="{Binding InstallCommand}"/><Button Content="Cancel" Command="{Binding CancelCommand}"/><Button Content="Project" Command="{Binding OpenProjectCommand}"/><Button Content="Package" Command="{Binding OpenPackageCommand}"/><Button Content="Build log" Command="{Binding OpenLogCommand}"/><Button Content="Evidence" Command="{Binding OpenEvidenceCommand}"/></WrapPanel>
</StackPanel></Border>
<TabControl x:Name="MainTabs" SelectionChanged="MainTabsChanged"><TabItem Header="Airport Builder"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,20"><TextBlock Text="{Binding ModeDescription}" FontWeight="Bold" Margin="0,0,0,14"/>
<Border Style="{StaticResource Card}"><StackPanel>
<WrapPanel><Button Content="New airport" Click="NewAirport" IsEnabled="{Binding CanManageAirports}"/><Button Content="Save airport" Command="{Binding SaveAirportCommand}"/></WrapPanel>
<TextBlock Text="{Binding SaveStatus}" FontWeight="SemiBold" Margin="0,0,0,10"/>
<TextBlock Style="{StaticResource Title}" Text="1. Connect to your flight"/>
<TextBlock Text="{Binding CheckInstructions}"/>
<Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><Label Content="_SDK folder" Target="{Binding ElementName=Sdk}"/><TextBox x:Name="Sdk" Text="{Binding SdkRoot, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSdk}"/></StackPanel><Button Grid.Column="1" Content="Check and connect" VerticalAlignment="Bottom" Margin="0,0,0,10" Command="{Binding CheckCommand}"/></Grid>
</StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel>
<TextBlock Style="{StaticResource Title}" Text="2. Stand at your runway centre"/>
<TextBlock Text="{Binding CaptureInstructions}"/>
<WrapPanel><Button Content="Capture survey" Command="{Binding CaptureCommand}"/><TextBlock Text="Empirical elevation · validated simulator build only" VerticalAlignment="Center" FontSize="12"/></WrapPanel>
<Border Background="#EDF4EF" Padding="12"><TextBlock Text="{Binding SurveyText}" FontFamily="Consolas" FontSize="15"/></Border>
<TextBlock Text="{Binding AfterCaptureInstructions}" Margin="0,10,0,0" FontWeight="SemiBold"/>
</StackPanel></Border>
<Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
<StackPanel IsEnabled="{Binding CanEdit}">
<TextBlock Style="{StaticResource Title}" Text="3. Define your airstrip"/>
<Label Content="Airport _name" Target="{Binding ElementName=NameField}"/><TextBox x:Name="NameField" Text="{Binding AirportName, UpdateSourceTrigger=PropertyChanged}"/>
<Label Content="_Identifier · 3–8 letters or digits, starting with a letter" Target="{Binding ElementName=IdField}"/><TextBox x:Name="IdField" IsEnabled="{Binding CanEditIdentifier}" Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><Label Content="_Length (metres)" Target="{Binding ElementName=LengthField}"/><TextBox x:Name="LengthField" Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="1"><Label Content="_Width (metres)" Target="{Binding ElementName=WidthField}"/><TextBox x:Name="WidthField" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
<Label Content="_Surface preset" Target="{Binding ElementName=SurfaceField}"/><ComboBox x:Name="SurfaceField" ItemsSource="{Binding SurfacePresets}" SelectedItem="{Binding SelectedSurfacePreset}" Padding="8" Margin="0,0,12,4"/><TextBlock Text="{Binding SurfacePresetDetail}" FontSize="11" TextWrapping="Wrap" Margin="0,0,12,12"/>
<CheckBox IsChecked="{Binding SiteConfirmed}" Margin="0,0,12,10"><TextBlock Text="{Binding SiteCheckText}"/></CheckBox>
<TextBlock Text="{Binding ValidationMessage}" Foreground="#695728" FontSize="12"/>
</StackPanel>
<StackPanel Grid.Column="1" Margin="18,0,0,0">
<TextBlock Text="Runway preview" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Designators}" FontSize="30" Margin="0,8"/>
<Grid Height="250" Background="#E3EBDF" ClipToBounds="True"><TextBlock Text="N ↑" HorizontalAlignment="Center" Margin="0,8" VerticalAlignment="Top"/><Rectangle Width="{Binding PreviewWidth}" Height="180" Fill="#9C8761" Stroke="#6D6048" RenderTransformOrigin=".5,.5"><Rectangle.RenderTransform><RotateTransform Angle="{Binding PreviewHeading}"/></Rectangle.RenderTransform></Rectangle><Ellipse Width="8" Height="8" Fill="#203C35"/></Grid>
<TextBlock Text="North up · centre dot is your survey. Designators use magnetic heading; orientation uses true heading. Width is exaggerated for narrow strips." FontSize="12" Margin="0,10"/>
</StackPanel></Grid></Border>
<Border Style="{StaticResource Card}"><StackPanel>
<TextBlock Style="{StaticResource Title}" Text="Airport layout · parking, taxiways and objects"/>
<TextBlock Text="Double-click empty ground to add a stand, or add the Prototype Base Lodge placeholder. Click to select, drag to move. Mouse wheel zooms; right or middle drag pans. R / Shift+R rotates; Delete removes; Ctrl+Z / Ctrl+Y undoes/redoes. Home fits the layout."/>
<WrapPanel><Button Content="Add stand" Command="{Binding AddParkingCommand}"/><Button Content="Add Prototype Base Lodge" Command="{Binding AddObjectCommand}"/><Button Content="Delete selected" Command="{Binding RemoveParkingCommand}"/><Button Content="Undo" Command="{Binding UndoLayoutCommand}"/><Button Content="Redo" Command="{Binding RedoLayoutCommand}"/><Button Content="Fit layout" Click="FitLayout"/><Button Content="Save layout…" Click="SaveLayout" IsEnabled="{Binding CanLayout}"/><Button Content="Load layout…" Click="LoadLayout" IsEnabled="{Binding CanLayout}"/></WrapPanel>
<WrapPanel><Button Content="New taxiway" Click="NewTaxiway" IsEnabled="{Binding CanLayout}"/><Button Content="Finish taxiway" Click="FinishTaxiway" IsEnabled="{Binding Layout.CanFinishTaxiway}"/><Button Content="Cancel drawing" Click="CancelTaxiway" IsEnabled="{Binding Layout.IsDrawingTaxiway}"/></WrapPanel>
<TextBlock Text="{Binding Layout.TaxiwayInstructions}"/>
<TextBlock Text="Site boundary: runway footprint plus 3 km; absolute reach 10 km. Wheel down to zoom out for distant stands." FontSize="12"/>
<WrapPanel IsEnabled="{Binding Layout.HasTaxiwaySelection}"><Label Content="Selected taxiway name"/><TextBox Width="90" Text="{Binding Layout.TaxiwayName,UpdateSourceTrigger=PropertyChanged}"/><Label Content="Width (3–60 m)"/><TextBox Width="70" Text="{Binding Layout.TaxiwayWidth,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Apply taxiway properties" Click="ApplyTaxiway"/></WrapPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
<local:AirportLayoutCanvas x:Name="LayoutCanvas" Height="430" MinWidth="300" Margin="0,0,16,0" AutomationProperties.Name="Airport layout canvas"/>
<StackPanel Grid.Column="1">
<StackPanel IsEnabled="{Binding Layout.HasSelection}">
<TextBlock Text="{Binding Layout.SelectedNumber, StringFormat='Selected stand {0}'}" FontWeight="Bold"/>
<Label Content="East offset (m)"/><TextBox Text="{Binding Layout.East,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
<Label Content="North offset (m)"/><TextBox Text="{Binding Layout.North,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
<Label Content="True heading (°)"/><TextBox Text="{Binding Layout.Heading,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
<Label Content="Radius (m)"/><TextBox Text="{Binding Layout.Radius,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
<TextBlock Text="Parking type" FontSize="12"/><ComboBox ItemsSource="{Binding Layout.Types}" SelectedItem="{Binding Layout.Type}" Margin="0,6"/><TextBlock Text="Parking name" FontSize="12"/><ComboBox ItemsSource="{Binding Layout.Names}" SelectedItem="{Binding Layout.Name}" Margin="0,6"/>
<Button Content="Apply properties" Command="{Binding ApplyParkingCommand}"/>
<WrapPanel><Button Content="↶ 15°" Command="{Binding RotateLeftCommand}"/><Button Content="↷ 15°" Command="{Binding RotateRightCommand}"/></WrapPanel>
</StackPanel>
<Separator Margin="0,12"/>
<StackPanel IsEnabled="{Binding Layout.HasObjectSelection}">
<TextBlock Text="{Binding Layout.SelectedObjectName}" FontWeight="Bold" TextWrapping="Wrap"/>
<TextBlock Text="{Binding Layout.SelectedObjectDetails}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,6"/>
<Label Content="East offset (m)"/><TextBox Text="{Binding Layout.ObjectEast,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
<Label Content="North offset (m)"/><TextBox Text="{Binding Layout.ObjectNorth,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
<Label Content="True heading (°)"/><TextBox Text="{Binding Layout.ObjectHeading,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
<Button Content="Apply object properties" Command="{Binding ApplyObjectCommand}"/>
<WrapPanel><Button Content="↶ 15°" Command="{Binding RotateLeftCommand}"/><Button Content="↷ 15°" Command="{Binding RotateRightCommand}"/></WrapPanel>
</StackPanel>
</StackPanel></Grid>
<TextBlock Text="{Binding Layout.Message}" Foreground="#A52222"/><TextBlock Text="{Binding Layout.IsDirty,StringFormat='Unsaved layout changes: {0}'}"/>
<TextBlock Text="Apply property edits before validating. The yellow shape is the true-scale footprint; its dot is the MSFS placement origin. The Base Lodge is explicitly a stock-hangar placeholder. Dashed and dotted outlines show the flat foundation and blended terrain edge. Taxiway surface follows the runway preset; no apron is created." FontSize="12"/>
</StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Title}" Text="4. Build, install and fly"/><TextBlock Text="Generate and compile creates an isolated project. Install verifies the package and backs up any previous installation owned by this app. FPT1 and FPSC are protected. The full runway footprint still needs a visual terrain check."/><TextBlock Text="{Binding SuccessInstructions}" FontWeight="SemiBold" Margin="0,10"/><Expander Header="Technical log (select text to copy)"><StackPanel><WrapPanel><Button Content="Copy technical log" Click="CopyLog"/><Button Content="Save technical log…" Click="SaveLog"/></WrapPanel><TextBox Text="{Binding TechnicalLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto"/></StackPanel></Expander></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Jobs"><Grid Margin="20" DataContext="{Binding Jobs}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Cargo Jobs" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Choose employed work from Eros or logistics for a founded operation. Route information describes known data and does not certify flight safety." TextWrapping="Wrap"/><Border Background="#FFF2CF" Padding="9" Margin="0,10,0,0"><TextBlock Text="PROTOTYPE · cargo masses and TPC payments are temporary. Use Aircraft Loading for verified MSFS payload integration or an explicit simulated compatibility mode." TextWrapping="Wrap"/></Border></StackPanel>
<WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button Content="Refresh jobs" Command="{Binding RefreshCommand}"/><Button Content="Accept selected job" Command="{Binding AcceptCommand}"/><Button Content="Prepare aircraft…" Click="OpenAircraftLoading"/><Button Content="Unload cargo…" Click="OpenAircraftLoading"/></WrapPanel>
<Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
<Grid><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Offers}" SelectedItem="{Binding SelectedOffer}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"><DataGrid.Columns>
<DataGridTextColumn Header="Employer" Binding="{Binding Employer}" Width="2*"/><DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="2*"/><DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="2*"/><DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" Width="*"/><DataGridTextColumn Header="Payment" Binding="{Binding Payment}" Width="*"/>
</DataGrid.Columns></DataGrid><TextBlock Grid.Row="1" Text="Recently completed" FontWeight="SemiBold" Margin="0,10,0,4"/><DataGrid Grid.Row="2" ItemsSource="{Binding CompletedJobs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="2*"/><DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" Width="*"/><DataGridTextColumn Header="Payment" Binding="{Binding Payment}" Width="*"/><DataGridTextColumn Header="State" Binding="{Binding Shipment}" Width="2*"/></DataGrid.Columns></DataGrid></Grid>
<StackPanel Grid.Column="1" Margin="14,0,0,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Selected offer" Style="{StaticResource Title}"/><TextBlock Text="Customer purpose" FontSize="11"/><TextBlock Text="{Binding SelectedPurpose}" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBlock Text="Known destination information" FontSize="11"/><TextBlock Text="{Binding SelectedDestinationInformation}" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Current cargo job" Style="{StaticResource Title}"/><TextBlock Text="{Binding ActiveRoute}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding ActiveCargo}" TextWrapping="Wrap"/><TextBlock Text="{Binding ActiveShipment}" FontFamily="Consolas"/><Separator Margin="0,8"/><TextBlock Text="{Binding FlightStage}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding FlightReason}" TextWrapping="Wrap" Margin="0,3,0,7"/><TextBlock Text="{Binding OriginDistance}"/><TextBlock Text="{Binding DestinationDistance}"/><TextBlock Text="{Binding Balance}" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock Text="Unload remains a deliberate player action. Only the flight tracker can create delivery evidence." FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border></StackPanel>
</Grid>
<StackPanel Grid.Row="3"><TextBlock Text="{Binding Status}" FontWeight="SemiBold"/><TextBlock Text="{Binding Error}" Foreground="#A52222" TextWrapping="Wrap"/><TextBlock Text="{Binding StoragePath}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding FlightStoragePath}" FontSize="9" TextWrapping="Wrap"/><Expander Header="Live flight evidence diagnostics" Margin="0,6,0,0"><StackPanel><TextBlock Text="Live observations" FontWeight="Bold"/><TextBlock Text="{Binding DiagnosticConnection,StringFormat='SimConnect: {0}'}"/><TextBlock Text="{Binding DiagnosticFreshness,StringFormat='Telemetry: {0}'}"/><TextBlock Text="{Binding DiagnosticLastSample,StringFormat='Last valid sample UTC: {0}'}"/><TextBlock Text="{Binding DiagnosticObservedAircraft,StringFormat='Observed aircraft: {0}'}" TextWrapping="Wrap"/><TextBlock Text="{Binding DiagnosticLiveValues}"/><TextBlock Text="{Binding DiagnosticDistances}"/><Separator Margin="0,5"/><TextBlock Text="Persisted evidence" FontWeight="Bold"/><TextBlock Text="{Binding FlightStage,StringFormat='Stage: {0}'}"/><TextBlock Text="{Binding DiagnosticRoute}"/><TextBlock Text="{Binding DiagnosticIds}" FontFamily="Consolas"/><TextBlock Text="{Binding DiagnosticRecordedAircraft,StringFormat='Recorded aircraft: {0}'}" TextWrapping="Wrap"/><TextBlock Text="{Binding DiagnosticPersistedEvidence}" TextWrapping="Wrap"/><Separator Margin="0,5"/><TextBlock Text="Derived diagnostic values" FontWeight="Bold"/><TextBlock Text="{Binding DiagnosticQualification}"/><TextBlock Text="{Binding DiagnosticUnavailableReason,StringFormat='Unavailable reason: {0}'}" TextWrapping="Wrap"/><TextBlock Text="Diagnostic events describe observations only; they never qualify a delivery or certify flight safety." FontSize="11" TextWrapping="Wrap" Margin="0,3"/><DataGrid ItemsSource="{Binding DiagnosticTimeline}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="150" Margin="0,5"><DataGrid.Columns><DataGridTextColumn Header="UTC" Binding="{Binding Utc}" Width="2*"/><DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="2*"/><DataGridTextColumn Header="Factual details" Binding="{Binding Details}" Width="4*"/></DataGrid.Columns></DataGrid><WrapPanel><Button Content="Copy diagnostic summary" Click="CopyFlightDiagnosticSummary"/><Button Content="Export support bundle…" Click="ExportFlightDiagnostic"/><Button Content="Reset incomplete observations…" Click="ResetIncompleteFlight" IsEnabled="{Binding CanResetIncompleteFlight}"/></WrapPanel></StackPanel></Expander></StackPanel>
</Grid></TabItem>
<TabItem Header="Aircraft Loading"><Grid Margin="20" DataContext="{Binding AircraftLoading}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Aircraft Loading · V0" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Inspect MSFS payload and fuel, apply a recoverable load, then commit the shipment InTransit. Values are factual simulator reports and do not certify airworthiness." TextWrapping="Wrap"/><Border Background="#FFF2CF" Padding="9" Margin="0,10,0,0"><TextBlock Text="Applying changes requires a stopped aircraft on the ground and a fresh guarded walking-avatar observation nearby. Fuel is free for this prototype. Cargo loading with engines running is permitted with a caution." TextWrapping="Wrap"/></Border></StackPanel>
<WrapPanel Grid.Row="1" Margin="0,10"><Button Content="Read live aircraft" Command="{Binding RefreshCommand}"/><Button Content="Restore manifest cargo…" Command="{Binding RestoreCargoCommand}"/><Button Content="Unload at verified destination" Command="{Binding UnloadCommand}"/><Button Content="Confirm simulated compatibility unload…" Click="ConfirmSimulatedUnload" IsEnabled="{Binding CanUnload}"/></WrapPanel>
<TabControl Grid.Row="2"><TabItem Header="Payload"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{Binding Aircraft}" FontWeight="Bold"/><TextBlock Text="{Binding Shipment}"/><TextBlock Text="{Binding CargoReason}" TextWrapping="Wrap"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding PayloadStations}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,8"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True"/><DataGridTextColumn Header="Station" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/><DataGridTextColumn Header="Existing kg" Binding="{Binding CurrentKilograms,StringFormat=F2}" IsReadOnly="True"/><DataGridTextColumn Header="Existing lb" Binding="{Binding CurrentPounds,StringFormat=F2}" IsReadOnly="True"/><DataGridTextColumn Header="Limit" Binding="{Binding Limit}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Frontier kg" Binding="{Binding AssignedKilograms,UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Planned kg" Binding="{Binding PlannedKilograms,StringFormat=F2}" IsReadOnly="True"/><DataGridTextColumn Header="Planned lb" Binding="{Binding PlannedPounds,StringFormat=F2}" IsReadOnly="True"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2"><TextBlock Text="{Binding AssignedCargo,StringFormat='Assigned Frontier cargo: {0:F2} kg'}"/><TextBlock Text="{Binding RemainingCargo,StringFormat='Remaining: {0:F2} kg'}"/><WrapPanel><Button Content="Distribute evenly" Command="{Binding AllocateEvenlyCommand}"/><Button Content="Clear Frontier allocation" Command="{Binding ClearAllocationCommand}"/><Button Content="Apply and verify in MSFS" Command="{Binding ApplyCargoCommand}"/><Button Content="Use simulated loading…" Command="{Binding SimulatedCargoCommand}"/></WrapPanel></StackPanel></Grid></TabItem>
<TabItem Header="Fuel"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Free prototype fuel · no inventory or financial transaction is created." FontWeight="Bold"/><TextBlock Text="{Binding EngineState}"/><TextBlock Text="{Binding FuelReason}" TextWrapping="Wrap"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding FuelTanks}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,8"><DataGrid.Columns><DataGridTextColumn Header="Tank" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/><DataGridTextColumn Header="Current US gal" Binding="{Binding CurrentGallons,StringFormat=F2}" IsReadOnly="True"/><DataGridTextColumn Header="Capacity US gal" Binding="{Binding CapacityGallons,StringFormat=F2}" IsReadOnly="True"/><DataGridTextColumn Header="Planned US gal" Binding="{Binding PlannedGallons,UpdateSourceTrigger=PropertyChanged}"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="2"><Button Content="Apply fuel" Command="{Binding ApplyFuelCommand}"/><Button Content="Restore saved fuel" Command="{Binding RestoreFuelCommand}"/><Button Content="Keep simulator fuel" Command="{Binding KeepFuelCommand}"/></WrapPanel></Grid></TabItem>
<TabItem Header="Weight &amp; Balance"><ScrollViewer><StackPanel Margin="12"><TextBlock Text="Current and planned factual values" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding WeightAndBalance}" FontFamily="Consolas" Margin="0,8"/><Border Background="#FFFFD8" Padding="8"><TextBlock Text="{Binding Warnings}" Foreground="#8A4500" FontWeight="SemiBold" TextWrapping="Wrap"/></Border><TextBlock Text="Maximum gross weight and reported CG-limit exceedances are warnings. Structural station limits and tank capacities remain hard limits. Planned CG is unavailable unless authoritative station geometry is exposed." TextWrapping="Wrap" Margin="0,8"/></StackPanel></ScrollViewer></TabItem></TabControl>
<StackPanel Grid.Row="3"><TextBlock Text="{Binding Status}" FontWeight="SemiBold"/><TextBlock Text="{Binding Error}" Foreground="#A52222" TextWrapping="Wrap"/><TextBlock Text="{Binding Reconciliation}" TextWrapping="Wrap"/><TextBlock Text="{Binding StoragePath}" FontSize="9" TextWrapping="Wrap"/></StackPanel>
</Grid></TabItem><TabItem Header="Operations"><Grid Margin="20" DataContext="{Binding Operations}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Prospecting Camp · Vertical Slice V0" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Found a small operation at one of your saved airstrips, then advance its explicit prototype day cycle. No real-time or offline progression occurs." TextWrapping="Wrap"/><Border Background="#FFF2CF" Padding="9" Margin="0,10,0,0"><TextBlock Text="TEMPORARY VALUES · founding costs 150 TPC. The current Base Lodge is a stock-hangar visual placeholder. Operations do not assess runway, aircraft or flight safety." TextWrapping="Wrap"/></Border></StackPanel>
<WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button Content="Refresh operations" Command="{Binding RefreshCommand}"/><Button Content="Found prospecting camp" Command="{Binding FoundCommand}"/><Button Content="Advance one prototype day" Command="{Binding AdvanceDayCommand}"/></WrapPanel>
<Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Saved airport sites" Style="{StaticResource Title}"/><DataGrid ItemsSource="{Binding Airports}" SelectedItem="{Binding SelectedAirport}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="220"><DataGrid.Columns><DataGridTextColumn Header="Airport" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="ID" Binding="{Binding Identifier}" Width="70"/><DataGridCheckBoxColumn Header="Linked" Binding="{Binding IsLinked}" Width="60"/></DataGrid.Columns></DataGrid><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Founding check" FontWeight="Bold"/><TextBlock Text="{Binding FoundingReason}" TextWrapping="Wrap"/><TextBlock Text="Requires a saved runway, Base Lodge capability, fresh guarded walking-avatar presence, and 150 TPC in the authoritative ledger." FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></StackPanel>
<StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Founded operations" Style="{StaticResource Title}"/><ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" DisplayMemberPath="SiteName" Margin="0,0,0,8"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding OperationTitle}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding OperationStatus,StringFormat='Status: {0}'}"/><TextBlock Text="{Binding PrototypeDay,StringFormat='Prototype day: {0}'}"/><TextBlock Text="{Binding Rations,StringFormat='Rations: {0}'}"/><TextBlock Text="{Binding RawMinerals,StringFormat='Raw minerals: {0}'}"/><Separator Margin="0,8"/><TextBlock Text="Last tick" FontWeight="Bold"/><TextBlock Text="{Binding LastTickResult}" TextWrapping="Wrap"/><TextBlock Text="Pending inbound and outbound logistics" FontWeight="Bold" Margin="0,8,0,2"/><ItemsControl ItemsSource="{Binding PendingLogistics}"/></StackPanel></Border></StackPanel>
</Grid>
<StackPanel Grid.Row="3"><TextBlock Text="{Binding Balance}" FontWeight="Bold"/><TextBlock Text="{Binding Status}" FontWeight="SemiBold"/><TextBlock Text="{Binding Error}" Foreground="#A52222" TextWrapping="Wrap"/><TextBlock Text="{Binding StoragePath}" FontSize="9" TextWrapping="Wrap"/></StackPanel>
</Grid></TabItem>
<TabItem Header="Tracking"><Grid Margin="20" DataContext="{Binding Tracking}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Live Aircraft and Player Tracking" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Read-only MSFS positions. Orange is the aircraft; blue is the verified walking avatar. Manual map pan and zoom are preserved."/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="Connect" Command="{Binding ConnectCommand}"/><Button Content="Disconnect" Command="{Binding DisconnectCommand}"/><Button Content="Centre on Aircraft" Click="CenterAircraft" IsEnabled="{Binding HasTelemetry}"/><Button Content="Centre on Player" Click="CenterPlayer" IsEnabled="{Binding HasPlayer}"/></WrapPanel></Grid>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
<Grid Background="#DCE6E1" ClipToBounds="True"><local:AircraftTrackingMap x:Name="TrackingMap"/><Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#DDFFFFFF" Padding="7" Margin="8"><TextBlock FontSize="11"><Hyperlink NavigateUri="https://www.openstreetmap.org/copyright" RequestNavigate="OpenMapAttribution">© OpenStreetMap contributors</Hyperlink></TextBlock></Border></Grid>
<Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Background="#203C35" Padding="8" Margin="0,0,0,10"><TextBlock Text="{Binding Freshness}" Foreground="White" FontWeight="Bold" TextWrapping="Wrap"/></Border><TextBlock Text="Aircraft" Style="{StaticResource Title}"/><TextBlock Text="{Binding Aircraft}" FontWeight="SemiBold"/><TextBlock Text="{Binding AircraftType}" FontSize="11" Margin="0,0,0,8"/><TextBlock Text="Position" FontSize="11"/><TextBlock Text="{Binding Position}" FontFamily="Consolas"/><TextBlock Text="{Binding Altitude}"/><TextBlock Text="{Binding Heading}"/><TextBlock Text="{Binding GroundSpeed}"/><TextBlock Text="{Binding FlightState}" Margin="0,0,0,10"/><Separator/>
<TextBlock Text="Player" Style="{StaticResource Title}" Margin="0,10,0,0"/><TextBlock Text="{Binding PlayerState}" FontWeight="SemiBold"/><TextBlock Text="{Binding PlayerPosition}" FontFamily="Consolas"/><TextBlock Text="{Binding PlayerAltitude}"/><TextBlock Text="{Binding PlayerHeading}"/><TextBlock Text="{Binding PlayerDistance, StringFormat='Distance from aircraft: {0}'}"/><TextBlock Text="{Binding PlayerTrackingStatus}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,10"/><Separator/>
<TextBlock Text="Frontier location" Style="{StaticResource Title}" Margin="0,10,0,0"/><TextBlock Text="{Binding FrontierAirport}" FontWeight="SemiBold"/><TextBlock Text="{Binding FrontierStand}"/><TextBlock Text="{Binding FrontierStandDistance, StringFormat='Stand distance: {0}'}"/><TextBlock Text="{Binding FrontierParkingState}" FontWeight="SemiBold" Margin="0,0,0,4"/><TextBlock Text="{Binding FrontierLocationDebug}" FontSize="10" TextWrapping="Wrap" Foreground="#52625D" Margin="0,0,0,10"/><Separator/>
<TextBlock Text="Tracking" FontSize="11" Margin="0,10,0,0"/><TextBlock Text="{Binding Status}" FontWeight="SemiBold"/><TextBlock Text="{Binding Error}" Foreground="#A52222" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding PersistenceWarning}" Foreground="#A52222" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding LastUpdate, StringFormat='Observation: {0}'}" FontSize="11" Margin="0,8,0,0"/><TextBlock Text="{Binding IntegrationDetails}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding StoragePath}" FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/><Button Content="Clear saved position…" Click="ClearTrackingState" IsEnabled="{Binding CanClearSavedState}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
<Expander Header="Tracking diagnostics" Margin="0,10,0,0"><StackPanel><Button Content="Copy diagnostics" Click="CopyTrackingLog" HorizontalAlignment="Left"/><TextBox Text="{Binding DiagnosticLog, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto"/></StackPanel></Expander>
</StackPanel></ScrollViewer></Border>
</Grid></Grid></TabItem>
<TabItem Header="My Airports"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="My Airports" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Your saved Frontier definitions. Opening one restores its survey and layout; validate and rebuild before installing again."/><TextBlock Text="{Binding LibraryPath}" FontSize="11" Margin="0,6"/></StackPanel>
<WrapPanel Grid.Row="1"><Button Content="Refresh list" Command="{Binding RefreshAirportsCommand}"/><Button Content="Open airport" Click="OpenAirport" IsEnabled="{Binding CanOpenAirport}"/><Button Content="Delete Airport…" Click="DeleteAirport" IsEnabled="{Binding CanOpenAirport}"/></WrapPanel>
<DataGrid Grid.Row="2" ItemsSource="{Binding Airports}" SelectedItem="{Binding SelectedAirport}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Margin="0,10"><DataGrid.Columns>
<DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Identifier" Binding="{Binding Identifier}" Width="90"/><DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="160"/><DataGridTextColumn Header="Last recorded status" Binding="{Binding Status}" Width="3*"/>
</DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="3"><TextBlock Text="{Binding LibraryWarnings}" Foreground="#A52222"/><TextBlock Text="Build/install entries are history, not a fresh verification of files. Deletion checks ownership and asks for confirmation. Close MSFS before deleting a live airport."/></StackPanel>
</Grid></TabItem></TabControl>
</DockPanel></Window>

