<TextBlock Text="Tracking" FontSize="11" Margin="0,10,0,0" /><TextBlock Text="{Binding Status}" FontWeight="SemiBold" /><TextBlock Text="{Binding Error}" Foreground="#FF9999" TextWrapping="Wrap" Margin="0,3,0,0" /><TextBlock Text="{Binding PersistenceWarning}" Foreground="#FF9999" TextWrapping="Wrap" Margin="0,4,0,0" /><TextBlock Text="{Binding LastUpdate, StringFormat='Observation: {0}'}" FontSize="11" Margin="0,8,0,0" /><TextBlock Text="{Binding IntegrationDetails}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" /><TextBlock Text="{Binding StoragePath}" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0" /><Button Content="Clear saved position…" Click="ClearTrackingState" IsEnabled="{Binding CanClearSavedState}" HorizontalAlignment="Left" Margin="0,8,0,0" />
<Expander Header="Tracking diagnostics" Margin="0,10,0,0"><StackPanel><Button Content="Copy diagnostics" Click="CopyTrackingLog" HorizontalAlignment="Left" /><TextBox Text="{Binding DiagnosticLog, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto" /></StackPanel></Expander>
<Expander Header="Aircraft condition recording" IsExpanded="True" Margin="0,12,0,0">
<StackPanel x:Name="ConditionRecordingPanel" DataContext="{Binding DataContext.ConditionRecording, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
<TextBlock Text="Development diagnostics · manual · read-only" TextWrapping="Wrap" Margin="0,6,0,4"/>
<TextBlock Text="{Binding Status}" FontWeight="Bold" TextWrapping="Wrap"/>
<TextBlock Text="{Binding Aircraft}" TextWrapping="Wrap" Margin="0,4"/>
<WrapPanel><TextBlock Text="Duration: "/><TextBlock Text="{Binding Duration}" Margin="0,0,12,0"/><TextBlock Text="Observations: "/><TextBlock Text="{Binding Observations}"/></WrapPanel>
<WrapPanel Margin="0,6"><Button Content="Start Recording" Command="{Binding StartCommand}"/><Button Content="Stop Recording" Command="{Binding StopCommand}"/></WrapPanel>
<TextBlock Text="Recording file" />
<TextBox Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="80" VerticalScrollBarVisibility="Auto"/>
<Button Content="Open recording folder" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Left"/>
<TextBlock Text="Receiving data does not verify aircraft compatibility or prove damage." TextWrapping="Wrap" Margin="0,4"/>
</StackPanel>
</Expander>
</StackPanel></ScrollViewer></Border>
</Grid></Grid></TabItem>
<TabItem Header="My Sites"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<StackPanel><TextBlock Text="My Sites" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="Saved Frontier operation sites at different infrastructure stages. Opening one restores its survey and layout so runway and parking can be added later; validate and rebuild before installing again." /><TextBlock Text="{Binding LibraryPath}" FontSize="11" Margin="0,6" /></StackPanel>
<WrapPanel Grid.Row="1"><Button Content="Create new site…" Click="CreateSiteFromLibrary" IsEnabled="{Binding CanManageAirports}" /><Button Content="Edit selected site…" Click="OpenAirport" IsEnabled="{Binding CanOpenAirport}" /><Button Content="Refresh list" Command="{Binding RefreshAirportsCommand}" /><Button Content="Delete site…" Click="DeleteAirport" IsEnabled="{Binding CanOpenAirport}" /></WrapPanel>
<DataGrid Grid.Row="2" ItemsSource="{Binding Airports}" SelectedItem="{Binding SelectedAirport}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Margin="0,10"><DataGrid.Columns>
<DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" /><DataGridTextColumn Header="Identifier" Binding="{Binding Identifier}" Width="90" /><DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="2*" /><DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="160" /><DataGridTextColumn Header="Last recorded status" Binding="{Binding Status}" Width="3*" />
</DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="3"><TextBlock Text="{Binding LibraryWarnings}" Foreground="#FF9999" /><TextBlock Text="Build/install entries are history, not a fresh verification of files. Deletion checks ownership and asks for confirmation. Close MSFS before deleting a live airport." /></StackPanel>
</Grid></TabItem><TabItem Header="Career / Settings"><StackPanel Margin="30"><TextBlock Text="Career" Style="{StaticResource Title}"/><TextBlock x:Name="CareerPilotLabel"/><TextBlock x:Name="EmploymentLabel" TextWrapping="Wrap" Margin="0,10"/><Button Content="Destination diagnostics / MSFS review" Click="OpenDestinations" HorizontalAlignment="Left"/><TextBlock Text="Map an exact live simulator identity to its supported company type. This grants access, not ownership. Select only the aircraft you have actually loaded." TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left" Margin="0,12"/><ComboBox x:Name="CompanyType" Width="300" HorizontalAlignment="Left"/><Button Content="Confirm current live aircraft type…" Click="BindCompanyAircraft" HorizontalAlignment="Left"/><Button Content="Delete Career…" Click="DeleteCareer" HorizontalAlignment="Left"/><TextBlock Text="Resets money, cargo jobs, passenger transfers, operations, inventories, flight progress, cargo manifests and saved fuel/aircraft state. Site definitions, installed scenery, SDK settings and diagnostic archives are retained." TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left" Margin="0,16"/></StackPanel></TabItem><TabItem x:Name="PassengerTab" Header="Passenger transfers"><local:PassengerTransfersControl DataContext="{Binding Passengers}"/></TabItem><TabItem x:Name="CargoTab" Header="Cargo dispatch / manifest"><local:CargoJourneyControl DataContext="{Binding CargoJourney}"/></TabItem></TabControl>
</DockPanel><local:CareerScreen x:Name="Onboarding" Grid.Row="1" Visibility="Collapsed"/></Grid></Window>
