<UserControl x:Class="FrontierAirportBuilder.Desktop.CareerMissionActions" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="0,8">
    <TextBlock Text="Observation flight operations" FontWeight="SemiBold" />
    <TextBlock Text="{Binding AreaCoordinates}" TextWrapping="Wrap" Margin="0,6" />
    <TextBlock Text="{Binding AreaDistance}" TextWrapping="Wrap" />
    <ProgressBar Value="{Binding Selected.ObservationSeconds}" Maximum="{Binding Selected.Area.ObservationSeconds}" Height="8" Margin="0,10" />
    <TextBlock Text="{Binding Progress}" />
    <TextBlock Text="{Binding FlightTime}" />
    <WrapPanel>
      <Button Content="Connect mission tracking" Command="{Binding ConnectCommand}" />
      <Button Content="Begin at base" Command="{Binding StartCommand}" />
      <Button Content="Resume recorded flight" Command="{Binding ResumeCommand}" />
      <Button Content="Complete mission" Command="{Binding CompleteCommand}" />
      <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
    </WrapPanel>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#F0B47B" />
  </StackPanel>
</UserControl>
