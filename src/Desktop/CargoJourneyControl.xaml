<UserControl x:Class="FrontierAirportBuilder.Desktop.CargoJourneyControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
  <Style x:Key="AssignmentCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="BorderThickness" Value="2"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,4,8,4"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding VisualState}" Value="Selected"><Setter Property="Background" Value="#223B4B"/><Setter Property="BorderBrush" Value="#76A9D4"/></DataTrigger>
    <DataTrigger Binding="{Binding VisualState}" Value="Paired"><Setter Property="Background" Value="#203C35"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
 <Grid Margin="0,0,14,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer x:Name="CargoWorkflowScroll" VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="Cargo loading &amp; dispatch" FontSize="23" FontWeight="SemiBold"/>
  <TextBlock Text="Click cargo, then a station. Confirm outside and apply in the cockpit." TextWrapping="Wrap" Margin="0,6"/>
  <TextBlock Text="Aircraft" Style="{StaticResource Title}" Margin="0,8,0,4"/>
  <ComboBox x:Name="CargoAircraft" ItemsSource="{Binding Fleet.AircraftRows}" SelectedValuePath="Id" SelectedValue="{Binding Fleet.SelectedAirframeId}" IsEnabled="{Binding CanChooseAircraft}" SelectionChanged="AircraftSelection_Changed">
   <ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Type}"/><Run Text=" · "/><Run Text="{Binding Registration}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate>
  </ComboBox>
  <Button Content="Refresh aircraft &amp; jobs" Command="{Binding ReadCommand}" HorizontalAlignment="Left"/>
  <TextBlock Text="{Binding AircraftStatus}" TextWrapping="Wrap" Margin="0,6"/>
  <TextBlock Text="{Binding LoadingBayHeading}" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,4"/>
  <TextBlock Text="Blue: selected. Green: proposed pairing, not loaded. Tab between cards; Enter or Space selects." FontSize="11"/>
  <ItemsControl x:Name="CargoConsignments" ItemsSource="{Binding Consignments}" IsEnabled="{Binding CanEditCargo}" Margin="0,5">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="174" Margin="0,0,4,4">
    <Button Click="LoadCargo_Click" Style="{StaticResource AssignmentCard}" AutomationProperties.Name="{Binding AccessibleDescription}" MinHeight="150">
     <StackPanel><TextBlock Text="{Binding Description}" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding WeightLabel}" Margin="0,6"/><TextBlock Text="{Binding DestinationLabel, StringFormat='TO: {0}'}" FontSize="12"/>
      <TextBlock Text="{Binding JobId}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
      <TextBlock Text="{Binding StateText}" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="{Binding AssignmentText}" FontSize="11"/>
     </StackPanel>
    </Button>
    <Button Content="Deliver" Click="DeliverCargo_Click" Visibility="{Binding CanDeliver, Converter={StaticResource VisibleWhenTrue}}"/>
   </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <Border Visibility="{Binding IsChoosingStation, Converter={StaticResource VisibleWhenTrue}}" Style="{StaticResource Card}" Padding="10" Margin="0,5">
   <StackPanel><TextBlock Text="{Binding PickupHeading}" FontWeight="SemiBold"/><TextBlock Text="{Binding PickupHelp}" FontSize="12"/>
    <WrapPanel><Expander Header="Partial amount / split" Margin="0,3,8,3"><StackPanel><TextBlock Text="Amount to assign (kg)"/><TextBox x:Name="PickupQuantity" Text="{Binding PickupQuantityText, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/></StackPanel></Expander>
     <Button Content="Clear selection" Click="ClosePicker_Click"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <TextBlock Text="Aircraft loading stations" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,4"/>
  <TextBlock Text="Schematic only. Boxes follow simulator station order, not physical compartment positions." FontSize="11"/>
  <Border x:Name="CargoStationPicker" Margin="0,6">
   <Grid x:Name="CargoStationDiagram" MinHeight="320">
    <!-- Generic vector outline: decoration only, never a source of station geometry or loading limits. -->
    <Path x:Name="CargoAircraftOutline" IsHitTestVisible="False" Stretch="Fill" Fill="{StaticResource PanelBrush}" Stroke="{StaticResource LineBrush}" StrokeThickness="2"
     Data="M 300,0 C 190,0 90,35 90,95 L 90,195 8,290 8,325 90,295 110,450 35,535 35,555 220,530 300,590 380,530 565,555 565,535 490,450 510,295 592,325 592,290 510,195 510,95 C 510,35 410,0 300,0 Z"/>
    <TextBlock Text="FRONT" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"/>
    <ItemsControl x:Name="PickupStations" ItemsSource="{Binding Stations}" Margin="58,52,58,65">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Button Click="ChooseStation_Click" Style="{StaticResource AssignmentCard}" MinHeight="90" Padding="6" Margin="3" IsEnabled="{Binding Writable}" AutomationProperties.Name="{Binding AccessibleDescription}" ToolTip="{Binding AccessibleDescription}">
       <StackPanel><TextBlock Text="{Binding StationLabel}" FontSize="12" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Actual, StringFormat='Actual {0:0.###} kg'}" FontSize="11" Margin="0,5,0,0"/>
        <TextBlock Text="{Binding PlannedTotal, StringFormat='Planned {0:0.###} kg'}" FontSize="11"/>
        <TextBlock Text="{Binding DiagramStateText}" FontSize="10" Margin="0,3,0,0"/>
       </StackPanel>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </Grid>
  </Border>
  <TextBlock Text="{Binding SelectedStationDetails}" FontSize="12" Margin="0,5"/>
  <TextBlock Text="Loading actions" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,4"/>
  <TextBlock Text="{Binding CargoSummary}" FontWeight="SemiBold" Margin="0,6"/>
  <ItemsControl x:Name="PickupPlan" ItemsSource="{Binding Pickups}" IsEnabled="{Binding CanEditCargo}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4">
   <TextBlock Text="{Binding Summary}"/><TextBlock Text="{Binding Destination, StringFormat='DELIVER TO: {0}'}" FontSize="11"/>
   <WrapPanel><Button Content="Change" Click="ChangePickup_Click"/><Button Content="Remove" Click="RemovePickup_Click"/></WrapPanel>
  </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Expander Header="Station distribution / details" Margin="0,7"><StackPanel IsEnabled="{Binding CanEditCargo}">
  <TextBlock Text="Partial delivery / manual quantities" FontWeight="SemiBold"/>
  <TextBlock Text="For a partial delivery, set the amount to retain aboard for that job. Routine pickups use cargo cards above." TextWrapping="Wrap"/>
  <DataGrid x:Name="CargoQuantityOverrides" ItemsSource="{Binding Consignments}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="90" MaxHeight="180" Margin="0,6"><DataGrid.Columns>
   <DataGridTextColumn Header="Job" Binding="{Binding JobId}" IsReadOnly="True" Width="*"/>
   <DataGridTextColumn Header="Aboard kg" Binding="{Binding Aboard}" IsReadOnly="True" Width="85"/>
   <DataGridTextColumn Header="Retain / planned kg" Binding="{Binding DesiredAboard, UpdateSourceTrigger=LostFocus}" Width="135"/>
  </DataGrid.Columns></DataGrid>
  <TextBlock Text="Unrelated payload is preserved. Only MSFS-reported station limits are enforced." TextWrapping="Wrap"/>
  <TextBlock Text="Station totals combine all managed cargo. New pickup choices appear above; deliveries reduce existing managed mass without removing unrelated payload." TextWrapping="Wrap"/>
  <DataGrid x:Name="CargoStations" ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="NaN" MinRowHeight="62" MinHeight="130" MaxHeight="270" Margin="0,8">
   <DataGrid.Columns>
    <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="30"/>
    <DataGridTemplateColumn Header="MSFS station" IsReadOnly="True" Width="*" MinWidth="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4,5">
     <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding CargoAboard, StringFormat='Cargo aboard: {0} kg'}" FontSize="10"/>
     <TextBlock Text="{Binding Writable, StringFormat='Writable: {0}'}" FontSize="10"/>
    </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="Actual kg" Binding="{Binding Actual}" IsReadOnly="True" Width="70"/>
    <DataGridTextColumn Header="Base kg" Binding="{Binding Unrelated}" IsReadOnly="True" Width="70"/>
    <DataGridTextColumn Header="Desired kg" Binding="{Binding DesiredCargo, UpdateSourceTrigger=LostFocus}" Width="90"/>
    <DataGridTextColumn Header="Limit kg" Binding="{Binding Limit}" IsReadOnly="True" Width="95"/>
   </DataGrid.Columns>
  </DataGrid>
  </StackPanel></Expander>
  <TextBlock Text="Next destination" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,5"/>
  <ComboBox x:Name="CargoDestination" ItemsSource="{Binding Stops}" SelectedItem="{Binding SelectedStop}" Margin="0,6"/>
  <Button Content="{Binding DepartureActionText}" Command="{Binding DepartureCommand}" HorizontalAlignment="Left"/>
  <TextBlock Text="Prepare while stopped. After ten tracking seconds, start recording before takeoff." TextWrapping="Wrap" FontSize="11"/>
  <Expander Header="Recovery / technical details" Margin="0,12"><StackPanel>
   <TextBlock Text="Use only when a saved plan needs attention. Cargo ownership and delivery proof remain protected." TextWrapping="Wrap"/>
   <WrapPanel><Button Content="Renew outside authorization" Command="{Binding RenewCommand}"/><Button Content="Discard unapplied / unarmed plan" Command="{Binding CancelPlanCommand}"/></WrapPanel>
   <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" Margin="0,8" Foreground="#E4BA76"/>
   <TextBox Text="{Binding TechnicalDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto"/>
  </StackPanel></Expander> </StackPanel></ScrollViewer><StackPanel Grid.Row="1">  <Border Background="#203C35" Padding="12" Margin="0,6"><StackPanel>
   <TextBlock Text="{Binding NextStep}" TextWrapping="Wrap" FontWeight="SemiBold"/>
   <Button x:Name="PrimaryCargoAction" Content="{Binding PrimaryActionText}" Command="{Binding PrimaryCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="14,9"/>
  </StackPanel></Border>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8" FontWeight="SemiBold"/>
</StackPanel></Grid>
 <Border Grid.Column="1" Background="#F0EBD9" BorderBrush="#B8B19D" BorderThickness="1" Padding="15">
  <Grid><Grid.Background><DrawingBrush TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Brush="#08A29270" Geometry="M 0,0 L 6,0 6,0.5 0,0.5 Z"/></DrawingBrush.Drawing></DrawingBrush></Grid.Background>
   <TextBox Text="{Binding ManifestText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="Transparent" Foreground="#292821" BorderThickness="0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0"/>
  </Grid>
 </Border></Grid>
</UserControl>
