<UserControl x:Class="FrontierAirportBuilder.Desktop.CargoJourneyControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
 <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,14,0"><StackPanel>
  <TextBlock Text="Cargo dispatch / multi-stop loading" FontSize="23" FontWeight="SemiBold"/>
  <TextBlock Text="Accept any additional jobs in Jobs. This loader selects consignments independently of station mass. Read after each pickup/delivery or job acceptance." TextWrapping="Wrap" Margin="0,6"/>
  <Button Content="Read aircraft / refresh consignments" Command="{Binding ReadCommand}" HorizontalAlignment="Left"/>
  <TextBlock Text="{Binding AircraftStatus}" TextWrapping="Wrap" Margin="0,6"/>
  <TextBlock Text="Available here and cargo aboard" FontSize="17" FontWeight="SemiBold"/>
  <TextBlock Text="Edit Desired aboard kg for each job. Leave through-cargo unchanged; set only the consignment being delivered to zero (or a smaller partial quantity)." TextWrapping="Wrap"/>
  <DataGrid x:Name="CargoConsignments" ItemsSource="{Binding Consignments}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="150" MaxHeight="310" Margin="0,8" SelectionUnit="Cell">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="Consignment / destination" Width="*" MinWidth="175" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="5,7" ToolTip="{Binding Origin}">
     <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Destination, StringFormat='TO: {0}'}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding JobId}" FontSize="10" TextWrapping="Wrap"/>
    </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="Here kg" Binding="{Binding AvailableHere}" IsReadOnly="True" Width="65"/>
    <DataGridTextColumn Header="Aboard kg" Binding="{Binding Aboard}" IsReadOnly="True" Width="75"/>
    <DataGridTextColumn Header="Desired kg" Binding="{Binding DesiredAboard, UpdateSourceTrigger=LostFocus}" Width="90"/>
    <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="95"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Text="Station distribution" FontSize="17" FontWeight="SemiBold"/>
  <TextBlock Text="Enter the TOTAL desired Frontier cargo per station. Its sum must match the selected consignments. Unrelated occupants, payload and fuel are preserved. No station maximum is invented when MSFS does not report one." TextWrapping="Wrap"/>
  <Button Content="Suggest station mass for selected consignments" Command="{Binding MatchMassCommand}" HorizontalAlignment="Left"/>
  <TextBlock Text="For a pickup, select its writable station below before suggesting. A delivery removes only owned cargo mass; review the suggested distribution before preparing." TextWrapping="Wrap"/>
  <DataGrid x:Name="CargoStations" ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="130" MaxHeight="270" Margin="0,8">
   <DataGrid.Columns>
    <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="30"/>
    <DataGridTemplateColumn Header="MSFS station" IsReadOnly="True" Width="*" MinWidth="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4,5">
     <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding CargoAboard, StringFormat='Cargo aboard: {0} kg'}" FontSize="10"/>
     <TextBlock Text="{Binding Writable, StringFormat='Writable: {0}'}" FontSize="10"/>
    </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="Actual kg" Binding="{Binding Actual}" IsReadOnly="True" Width="70"/>
    <DataGridTextColumn Header="Base kg" Binding="{Binding Unrelated}" IsReadOnly="True" Width="70"/>
    <DataGridTextColumn Header="Desired kg" Binding="{Binding DesiredCargo, UpdateSourceTrigger=LostFocus}" Width="90"/>
    <DataGridTextColumn Header="Limit kg" Binding="{Binding Limit}" IsReadOnly="True" Width="95"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Text="1. Exit near the aircraft and prepare a preview. 2. Review the pending targets on the dispatch sheet. 3. Board the same aircraft and apply. Failed writes retain the intent; retry only after reviewing the recovery message." TextWrapping="Wrap"/>
  <WrapPanel><Button Content="Prepare preview (outside)" Command="{Binding PrepareCommand}"/><Button Content="Apply / retry (seated)" Command="{Binding ApplyCommand}"/><Button Content="Renew outside authorization" Command="{Binding RenewCommand}"/><Button Content="Discard unapplied / unarmed plan" Command="{Binding CancelPlanCommand}"/></WrapPanel>
  <TextBlock Text="Next flight leg" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,5"/>
  <TextBlock Text="Plan the next stop, remain stopped for ten tracking seconds and arm BEFORE departure. Through-cargo gets a new leg; accepting new jobs in flight does not grant them earlier flight evidence. Employed wages settle once per qualified leg." TextWrapping="Wrap"/>
  <ComboBox ItemsSource="{Binding Stops}" SelectedItem="{Binding SelectedStop}" Margin="0,6"/>
  <WrapPanel><Button Content="Plan next stop" Command="{Binding PlanLegCommand}"/><Button Content="Arm flight leg" Command="{Binding ArmLegCommand}"/></WrapPanel>
  <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" Margin="0,8" Foreground="#E4BA76"/>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8" FontWeight="SemiBold"/>
 </StackPanel></ScrollViewer>
 <Border Grid.Column="1" Background="#F0EBD9" BorderBrush="#B8B19D" BorderThickness="1" Padding="15">
  <Grid><Grid.Background><DrawingBrush TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Brush="#08A29270" Geometry="M 0,0 L 6,0 6,0.5 0,0.5 Z"/></DrawingBrush.Drawing></DrawingBrush></Grid.Background>
   <TextBox Text="{Binding ManifestText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="Transparent" Foreground="#292821" BorderThickness="0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0"/>
  </Grid>
 </Border></Grid>
</UserControl>
