<UserControl x:Class="FrontierAirportBuilder.Desktop.AircraftFuelControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="#1A2A34" CornerRadius="6" Padding="12" Margin="0,10">
  <StackPanel>
   <DockPanel><Button DockPanel.Dock="Right" Content="Read aircraft fuel" Command="{Binding RefreshCommand}" Padding="10,5"/><TextBlock Text="Fuel" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <TextBlock Text="US gallons. Stop all engines and walk outside near the selected aircraft before applying fuel. Prototype fuel is free." TextWrapping="Wrap" FontSize="11" Margin="0,5"/>
   <TextBlock Text="{Binding EngineState}" Foreground="#A8CFC1"/>
   <ItemsControl ItemsSource="{Binding FuelTanks}"><ItemsControl.ItemTemplate><DataTemplate>
    <WrapPanel Margin="0,5">
     <TextBlock Text="{Binding Name}" MinWidth="130" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <TextBlock Text="{Binding CurrentGallons,StringFormat='Actual {0:0.00} gal'}" MinWidth="110" VerticalAlignment="Center"/>
     <TextBlock Text="Load to" VerticalAlignment="Center"/>
     <TextBox Text="{Binding PlannedGallonsText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="85" Padding="6,4" AutomationProperties.Name="Planned fuel in US gallons"/>
     <TextBlock Text="{Binding CapacityGallons,StringFormat='Capacity {0:0.00} gal'}" VerticalAlignment="Center" Margin="6,0"/>
    </WrapPanel>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="{Binding FuelPlanState}" FontWeight="SemiBold" Margin="0,5"/>
   <TextBlock Text="{Binding FuelReason}" Foreground="#F0B47B" TextWrapping="Wrap"/>
   <WrapPanel><Button x:Name="ApplyFuel" Content="Apply fuel changes" Command="{Binding ApplyFuelCommand}"/><Button Content="Keep simulator fuel" Command="{Binding KeepFuelCommand}" Visibility="{Binding FuelDecisionRequired,Converter={StaticResource BoolVisibility}}"/></WrapPanel>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11"/>
   <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#F0B47B"/>
  </StackPanel>
 </Border>
</UserControl>
