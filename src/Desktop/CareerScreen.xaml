<UserControl x:Class="FrontierAirportBuilder.Desktop.CareerScreen" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FrontierAirportBuilder.Desktop" Background="#111A22">
<Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="FRONTIER PILOT" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="StepTitle" FontSize="30" FontWeight="SemiBold" Margin="0,10"/><TextBlock x:Name="ErrorText" Foreground="#FF9999" TextWrapping="Wrap"/></StackPanel>
<Grid Grid.Row="1">
<StackPanel x:Name="Welcome" VerticalAlignment="Center" MaxWidth="650" HorizontalAlignment="Left"><TextBlock Text="Your flying career starts here." FontSize="27"/><TextBlock Text="Begin as an employed pilot. Your future employer will determine your initial base, company aircraft and kinds of work." TextWrapping="Wrap" Margin="0,18"/><TextBlock Text="Explore the starting opportunities. Employment acceptance is coming soon." TextWrapping="Wrap" Foreground="#9FB4C1"/><Button Content="New Career" Click="Continue" HorizontalAlignment="Left" Margin="0,24"/></StackPanel>
<StackPanel x:Name="NameStep" VerticalAlignment="Center" MaxWidth="600" HorizontalAlignment="Left"><TextBlock Text="Begin as an employed pilot. Your employer will shape your initial base, company aircraft and work." TextWrapping="Wrap" Margin="0,10"/><Label Content="Pilot Name" Target="{Binding ElementName=PilotName}"/><TextBox x:Name="PilotName" Text="{Binding PilotName,UpdateSourceTrigger=PropertyChanged}" MaxLength="48" MinWidth="380"/><TextBlock Text="{Binding NameError}" TextWrapping="Wrap" Foreground="#E6BC76" Margin="0,8"/><Button Content="Continue to region" Click="Continue" HorizontalAlignment="Left"/></StackPanel>
<Grid x:Name="MapStep"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Margin="0,0,20,0"><local:OperationsWorldMap x:Name="Map"/><Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#EE1A2732" Padding="7"><TextBlock FontSize="11"><Hyperlink NavigateUri="https://www.openstreetmap.org/copyright" RequestNavigate="Attribution">© OpenStreetMap contributors</Hyperlink></TextBlock></Border></Grid>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
<StackPanel x:Name="RegionStep"><TextBlock Text="Choose your starting region" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Select a region on the map or from the list. More regions can be added later." TextWrapping="Wrap" Margin="0,12"/><ListBox x:Name="RegionsList" ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion}" DisplayMemberPath="Name" MinHeight="60"/><Button Content="Explore employment opportunities" Click="Continue" Margin="0,18"/></StackPanel>
<StackPanel x:Name="EmployerStep"><TextBlock Text="Employment opportunities" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="BaseHint" Text="Choose Eros or Walvis Bay on the map, or select any company below." TextWrapping="Wrap" Margin="0,12"/><ListBox x:Name="EmployersList" ItemsSource="{Binding Employers}" SelectedItem="{Binding SelectedEmployer}" MinHeight="160"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Role}" FontSize="12"/><TextBlock Text="COMING SOON" FontSize="11" Foreground="#E6BC76"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Border Style="{StaticResource Card}" Margin="0,16"><StackPanel><TextBlock Text="{Binding SelectedEmployer.Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="COMING SOON" Foreground="#E6BC76" FontWeight="Bold" Margin="0,12"/><TextBlock Text="{Binding SelectedEmployer.Role}" FontSize="18"/><TextBlock Text="{Binding EmployerBase,StringFormat='Base: {0}'}" Margin="0,10"/><TextBlock Text="{Binding SelectedEmployer.Aircraft,StringFormat='Company aircraft: {0}'}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedEmployer.Description}" TextWrapping="Wrap" Margin="0,14"/><TextBlock Text="{Binding SelectedEmployer.Work}" TextWrapping="Wrap" Foreground="#9FB4C1"/><TextBlock Text="Offers cannot be accepted in this version. No employment, aircraft access or missions have been activated." TextWrapping="Wrap" Margin="0,18"/></StackPanel></Border></StackPanel>
</StackPanel></ScrollViewer></Grid></Grid>
<DockPanel Grid.Row="2" Margin="0,20,0,0"><Button x:Name="BackButton" Content="Back" Click="Back" HorizontalAlignment="Left"/><Button Content="Delete Career…" Click="Delete" HorizontalAlignment="Right"/><TextBlock Text="Your draft is saved when you continue or go back." VerticalAlignment="Center" Margin="12,0" Foreground="#9FB4C1"/></DockPanel>
</Grid></UserControl>
